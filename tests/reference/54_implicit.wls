(* Ground truth for tests/54_diff_implicit.c: solutions x of g(x, theta) = 0
   (closest points, curve pair, plane crossing, extremum, inflection,
   surface-curve piercing) and their derivatives, at 30 digits.

   The solution is found with FindRoot at 40 digits from the best point of
   a grid (the global minimum for the closest point problems). With
   J = dg/dx, G = dg/dtheta, Y = dy/dx, Yt = dy/dtheta (all symbolic
   derivatives evaluated at the solution), the implicit function theorem gives
     x_dot = -J^-1 G theta_dot,  y_dot = Y x_dot + Yt theta_dot
   and the adjoint of an output weight ybar is
     theta_bar = Yt^T ybar - G^T J^-T Y^T ybar.
   Every parameter vector theta, direction theta_dot and weight ybar uses
   exact rationals:
     theta_dot[k] = (((7 k + 3) mod 11) - 5) / 10,
     ybar[k]      = (((5 k + 2) mod 9) - 4) / 10   (k from 0).
   Run: wolframscript -file 54_implicit.wls > 54_implicit.h *)
fmt[v_] := Module[{m, x}, {m, x} = MantissaExponent[N[v, 20]]; If[v == 0, "0.0", ToString[NumberForm[N[m, 18], 17]] <> "e" <> ToString[x]]];
row[name_, l_] := Print["static double const " <> name <> "[] = { " <> StringRiffle[fmt /@ N[Flatten[{l}], 30], ", "] <> " };"];
Print["/* Generated by tests/reference/54_implicit.wls (Mathematica, 30 digits). */"];
dirOf[n_] := Table[(Mod[7 k + 3, 11] - 5)/10, {k, 0, n - 1}];
barOf[n_] := Table[(Mod[5 k + 2, 9] - 4)/10, {k, 0, n - 1}];

(* g, y: functions of (x list, theta list) *)
solve[tag_, gF_, yF_, th0_, seed_] := Module[{nx = Length[seed], nt = Length[th0], xv, tv, sol, xs, J, G, Y, Yt, thd, ybar, xd, lam},
  xv = Array[xx, nx]; tv = Array[tt, nt];
  sol = FindRoot[Thread[gF[xv, th0] == 0], Transpose[{xv, SetPrecision[seed, 40]}], WorkingPrecision -> 40,
    AccuracyGoal -> 36, PrecisionGoal -> 36, MaxIterations -> 200];
  xs = xv /. sol;
  J = D[gF[xv, th0], {xv}] /. sol;
  Y = D[yF[xv, th0], {xv}] /. sol;
  G = D[gF[xs, tv], {tv}] /. Thread[tv -> th0];
  Yt = D[yF[xs, tv], {tv}] /. Thread[tv -> th0];
  thd = dirOf[nt];
  ybar = barOf[Length[Y]];
  xd = -LinearSolve[J, G . thd];
  lam = LinearSolve[Transpose[J], Transpose[Y] . ybar];
  row["ref_" <> tag <> "_value", yF[xs, th0]];
  row["ref_" <> tag <> "_tangent", Y . xd + Yt . thd];
  row["ref_" <> tag <> "_adjoint", Transpose[Yt] . ybar - Transpose[G] . lam];
  Print["/* " <> tag <> ": residual " <> fmt[Max[Abs[gF[xs, th0]]] + 10^-60] <> " */"];
  xs];

(* cubic B-spline on knots 0 0 0 0 1 2 3 3 3 3, piecewise in t *)
knots = {0, 0, 0, 0, 1, 2, 3, 3, 3, 3};
bas = Table[PiecewiseExpand[BSplineBasis[{3, knots}, i, t]], {i, 0, 5}];
curve[P_, s_] := (bas . P) /. t -> s;
dcurve[P_, s_, k_] := D[bas, {t, k}] . P /. t -> s;
(* bicubic NURBS on [0, 1]^2 *)
bern = Table[Binomial[3, i] z^i (1 - z)^(3 - i), {i, 0, 3}];
bb[u_, v_] := Flatten[Outer[Times, bern /. z -> u, bern /. z -> v]];
surf[P_, w_, u_, v_] := (bb[u, v] w) . P / (bb[u, v] . w);

PA = {{0, 0, 0}, {1, 7/10, 3/10}, {2, 4/5, -1/5}, {3, 1/10, 1/4}, {4, -3/5, -1/10}, {5, -1/2, 1/5}};
PB = Table[{2/5 + 9 n/10, 13/10 - 11 n/20, 9/10 - n/10}, {n, 0, 5}];
PC = Table[{3/5 + 2 n/5, 9/10 + 3 n/10, -4/5 + 7 n/20}, {n, 0, 5}];
SP = Flatten[Table[{i + (Mod[i + 2 j, 3] - 1)/10, j + (Mod[2 i + j, 3] - 1)/10,
  2/5 (i - 3/2)^2 - 1/4 (j - 3/2)^2 + (Mod[i + j, 3] - 1)/10}, {i, 0, 3}, {j, 0, 3}], 1];
SW = Flatten[Table[1 + (2 Mod[i + 3 j, 4] - 3)/10, {i, 0, 3}, {j, 0, 3}]];
P3[th_, o_] := Partition[th[[o + 1 ;; o + 18]], 3];

(* closest point on the 3D curve: theta = (P 18, q 3), y = (t, C, |C - q|) *)
Do[Module[{q = qs, g, y, th0 = Join[Flatten[PA], qs], seed},
    g = Function[{x, th}, {dcurve[P3[th, 0], x[[1]], 1] . (curve[P3[th, 0], x[[1]]] - th[[19 ;; 21]])}];
    y = Function[{x, th}, Module[{c = curve[P3[th, 0], x[[1]]]}, Join[{x[[1]]}, c, {Sqrt[(c - th[[19 ;; 21]]) . (c - th[[19 ;; 21]])]}]]];
    seed = {3 First[SortBy[Table[{Norm[curve[N[PA], N[3 k/300]] - q], k/300}, {k, 0, 300}], First]][[2]]};
    solve["cc" <> ToString[Position[{{3/2, 6/5, 9/10}, {14/5, -1/5, -1/2}}, qs][[1, 1]] - 1], g, y, th0, seed]],
  {qs, {{3/2, 6/5, 9/10}, {14/5, -1/5, -1/2}}}];

(* closest point on the NURBS patch: theta = (P 48, w 16, q 3), y = (u, v, S, |S - q|) *)
Module[{q = {3/2, 7/5, 6/5}, g, y, th0, seed},
  th0 = Join[Flatten[SP], SW, q];
  g = Function[{x, th}, Module[{P = Partition[th[[1 ;; 48]], 3], w = th[[49 ;; 64]], uu, vv, s},
    s = surf[P, w, uu, vv];
    {D[s, uu] . (s - th[[65 ;; 67]]), D[s, vv] . (s - th[[65 ;; 67]])} /. {uu -> x[[1]], vv -> x[[2]]}]];
  y = Function[{x, th}, Module[{s = surf[Partition[th[[1 ;; 48]], 3], th[[49 ;; 64]], x[[1]], x[[2]]]},
    Join[x, s, {Sqrt[(s - th[[65 ;; 67]]) . (s - th[[65 ;; 67]])]}]]];
  seed = First[SortBy[Flatten[Table[{Norm[surf[N[SP], N[SW], N[a/40], N[b/40]] - q], {a/40, b/40}}, {a, 0, 40}, {b, 0, 40}], 1], First]][[2]];
  solve["sc", g, y, th0, seed]];

(* closest approach of two 3D curves: theta = (A 18, B 18), y = (ta, tb, A, B, |A - B|) *)
Module[{g, y, seed},
  g = Function[{x, th}, Module[{r = curve[P3[th, 0], x[[1]]] - curve[P3[th, 18], x[[2]]]},
    {dcurve[P3[th, 0], x[[1]], 1] . r, dcurve[P3[th, 18], x[[2]], 1] . r}]];
  y = Function[{x, th}, Module[{a = curve[P3[th, 0], x[[1]]], b = curve[P3[th, 18], x[[2]]]},
    Join[x, a, b, {Sqrt[(a - b) . (a - b)]}]]];
  seed = First[SortBy[Flatten[Table[{Norm[curve[N[PA], N[3 a/60]] - curve[N[PB], N[3 b/60]]], {3 a/60, 3 b/60}}, {a, 0, 60}, {b, 0, 60}], 1], First]][[2]];
  solve["pair", g, y, Join[Flatten[PA], Flatten[PB]], seed]];

(* plane crossing: theta = (P 18, point 3, normal 3), y = (t, C) *)
Module[{g, y, seed},
  g = Function[{x, th}, {th[[22 ;; 24]] . (curve[P3[th, 0], x[[1]]] - th[[19 ;; 21]])}];
  y = Function[{x, th}, Join[x, curve[P3[th, 0], x[[1]]]]];
  seed = {3 First[SortBy[Table[{Abs[{1, 3/10, -1/5} . (curve[N[PA], N[3 k/300]] - {11/5, 3/10, 1/10})], k/300}, {k, 0, 300}], First]][[2]]};
  solve["plane", g, y, Join[Flatten[PA], {11/5, 3/10, 1/10}, {1, 3/10, -1/5}], seed]];

(* 2D curve (the inflection of the xy projection of PA sits on a knot) *)
P2[th_] := Partition[th[[1 ;; 12]], 2];
PA2 = {{0, 0}, {1, 7/10}, {2, 4/5}, {3, 1/5}, {4, -3/5}, {5, -1/2}};
(* extremum of e . C: theta = (P 12, e 3), y = (t, Cx, Cy, e . C) *)
Module[{g, y, seed, e3 = {0, 1, 0}},
  g = Function[{x, th}, {th[[13 ;; 14]] . dcurve[P2[th], x[[1]], 1]}];
  y = Function[{x, th}, Module[{c = curve[P2[th], x[[1]]]}, Join[x, c, {th[[13 ;; 14]] . c}]]];
  seed = {3 First[SortBy[Table[{-curve[N[PA2], N[3 k/300]][[2]], k/300}, {k, 1, 299}], First]][[2]]};
  solve["ext", g, y, Join[Flatten[PA2], e3], seed]];
(* inflection of the xy projection: theta = P 12, y = (t, Cx, Cy) *)
Module[{g, y, seed},
  g = Function[{x, th}, Module[{c1 = dcurve[P2[th], x[[1]], 1], c2 = dcurve[P2[th], x[[1]], 2]}, {c1[[1]] c2[[2]] - c1[[2]] c2[[1]]}]];
  y = Function[{x, th}, Join[x, curve[P2[th], x[[1]]]]];
  seed = {3 First[SortBy[Table[{Abs[g[{N[3 k/300]}, N[Flatten[PA2]]][[1]]], k/300}, {k, 1, 299}], First]][[2]]};
  solve["infl", g, y, Flatten[PA2], seed]];

(* surface-curve piercing: theta = (surface P 48, curve P 18), weights fixed, y = (u, v, t, S) *)
Module[{g, y, seed},
  g = Function[{x, th}, surf[Partition[th[[1 ;; 48]], 3], SW, x[[1]], x[[2]]] - curve[P3[th, 48], x[[3]]]];
  y = Function[{x, th}, Join[x, surf[Partition[th[[1 ;; 48]], 3], SW, x[[1]], x[[2]]]]];
  seed = First[SortBy[Flatten[Table[{Norm[surf[N[SP], N[SW], N[a/20], N[b/20]] - curve[N[PC], N[3 c/30]]], {a/20, b/20, 3 c/30}},
    {a, 0, 20}, {b, 0, 20}, {c, 0, 30}], 2], First]][[2]];
  solve["pierce", g, y, Join[Flatten[SP], Flatten[PC]], seed]];
