(* Ground truth for tests/66_exact_winding.c: winding numbers of closed
   loops of rational quadratic Beziers (circle-like conics with integer
   lattice control points and integer weights) around points a tiny
   distance inside or outside the boundary.

   For each piece the crossings of the ray x > p_x solve
   f(t) = Y(t) - p_y W(t) = 0 exactly (algebraic roots in [0, 1)), keep
   those with g(t) = X(t) - p_x W(t) > 0 and add sign(f'(t)).
   Points are dyadic doubles {m, e} (value m 2^e) in lattice units.
   Run: wolframscript -file 66_exact_winding.wls > 66_exact_winding.h *)
SeedRandom[6666];
bern[n_, i_, t_] := Binomial[n, i] t^i (1 - t)^(n - i);
hom[cp_, w_, t_] := Module[{n = Length[cp] - 1}, Sum[bern[n, i, t] w[[i + 1]] Append[cp[[i + 1]], 1], {i, 0, n}]];
(* a loop of four quarter conics around the origin, radius R, weight w1 / w0 ~ 1/sqrt 2 *)
loop[R_, w0_, w1_, cx_, cy_] := Table[
	Module[{a = k Pi/2, b = (k + 1) Pi/2},
		{{{cx + Round[R Cos[a]], cy + Round[R Sin[a]]}, {cx + Round[R (Cos[a] - Sin[a])], cy + Round[R (Sin[a] + Cos[a])]},
			{cx + Round[R Cos[b]], cy + Round[R Sin[b]]}}, {w0, w1, w0}}], {k, 0, 3}];
crossings[pieces_, {px_, py_}] := Total[Table[
	Module[{cp = pc[[1]], w = pc[[2]], t, H, f, g, roots},
		H = hom[cp, w, t];
		f = H[[2]] - py H[[3]];
		g = H[[1]] - px H[[3]];
		roots = t /. Solve[f == 0 && 0 <= t < 1, t, Reals];
		If[roots === t, 0, Total[If[Simplify[(g /. t -> #) > 0], Sign[D[f, t] /. t -> #], 0] & /@ roots]]],
	{pc, pieces}]];
dy[x_] := Module[{r = x, k}, If[r == 0, {0, 0}, k = If[IntegerQ[r], 0, Log2[Denominator[r]]]; {r 2^k, -k}]];
R = 2^20; w0 = 2^20; w1 = Round[2^20/Sqrt[2]];
pieces = loop[R, w0, w1, 1000, -2000];
pts = Flatten[Table[
	Module[{pc = pieces[[RandomInteger[{1, 4}]]], t0 = RandomInteger[{1, 2^10 - 1}]/2^10, t, H, P, d, nrm, q},
		H = hom[pc[[1]], pc[[2]], t];
		P = (H[[;; 2]]/H[[3]]) /. t -> t0;
		d = D[H[[;; 2]]/H[[3]], t] /. t -> t0;
		nrm = N[{-d[[2]], d[[1]]}/Norm[d], 30];
		q = P + sgn 2^-28 nrm;
		Round[2^32 q]/2^32],
	{60}, {sgn, {-1, 1}}], 1];
(* also points well inside / outside and far away *)
pts = Join[pts, {{1000, -2000}, {1000 + 2 R, -2000}, {1000 + R/2, -2000 + R/4}, {-10^7, 5}}];
Print["/* Generated by 66_exact_winding.wls; do not edit. */"];
Print["static long long const g_ref_wind_pieces[4][3][2] = {"];
Do[Print["\t{ ", StringRiffle["{ " <> ToString[#[[1]]] <> ", " <> ToString[#[[2]]] <> " }" & /@ pc[[1]], ", "], " },"], {pc, pieces}];
Print["};"];
Print["static long long const g_ref_wind_weights[3] = { ", w0, ", ", w1, ", ", w0, " };"];
Print["typedef struct ref_wind { long long mx; int ex; long long my; int ey; int winding; } ref_wind;"];
Print["static ref_wind const g_ref_wind[] = {"];
Do[Module[{a = dy[p[[1]]], b = dy[p[[2]]]},
	Print["\t{ ", a[[1]], ", ", a[[2]], ", ", b[[1]], ", ", b[[2]], ", ", crossings[pieces, p], " },"]], {p, pts}];
Print["};"];
