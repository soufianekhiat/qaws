(* Ground truth for tests/72_exact_curve_hits_3d.c: intersections of two 3D
   Bezier / rational Bezier curves, A(s) = B(r) with s, r in [0, 1].

   Solved exactly from the three homogeneous equations
   X_A W_B - X_B W_A = 0 (and Y, Z). Cases: pairs lying in one plane
   z = al x + be y + ga (irrational intersections), random pairs in space
   (their projections cross, the curves do not meet), and polynomial pairs
   built to meet at A(1/2) = B(1/2). Parameters as 25-digit decimals with
   dyadic flags; coordinates are lattice integers (2^-10 world units).
   Run: wolframscript -file 72_exact_curve_hits_3d.wls > 72_exact_curve_hits_3d.h *)
SeedRandom[7272];
bern[n_, i_, t_] := Binomial[n, i] t^i (1 - t)^(n - i);
hom[cp_, w_, t_] := Module[{n = Length[cp] - 1}, Append[Table[Sum[bern[n, i, t] w[[i + 1]] cp[[i + 1, c]], {i, 0, n}], {c, 3}],
	Sum[bern[n, i, t] w[[i + 1]], {i, 0, n}]]];
dyadicQ[r0_] := Module[{r = RootReduce[r0]}, IntegerQ[r] || (Head[r] === Rational && Denominator[r] == 2^(IntegerLength[Denominator[r], 2] - 1))];
fmt[r_] := If[r == 0, "0", Module[{m, e}, {m, e} = MantissaExponent[N[r, 40]]; ToString[Round[m 10^25]] <> "e" <> ToString[e - 25]]];
w2[d_, rat_] := If[rat == 1, RandomInteger[{1, 40}, d + 1], ConstantArray[1, d + 1]];
lift[cp2_, al_, be_, ga_] := {#[[1]], #[[2]], al #[[1]] + be #[[2]] + ga} & /@ cp2;
cases = {};
(* planar pairs *)
Do[
	Module[{al = RandomInteger[{-2, 2}], be = RandomInteger[{-2, 2}], ga = RandomInteger[{-2^16, 2^16}]},
		AppendTo[cases, {da, ra, lift[RandomInteger[{-2^17, 2^17}, {da + 1, 2}], al, be, ga], w2[da, ra],
			db, rb, lift[RandomInteger[{-2^17, 2^17}, {db + 1, 2}], al, be, ga], w2[db, rb]}]],
	{da, {1, 2, 3}}, {db, {2, 3}}, {ra, {0, 1}}, {rb, {0, 1}}];
(* random space pairs *)
Do[
	AppendTo[cases, {da, ra, RandomInteger[{-2^19, 2^19}, {da + 1, 3}], w2[da, ra], db, 0, RandomInteger[{-2^19, 2^19}, {db + 1, 3}], w2[db, 0]}],
	{da, {2, 3}}, {db, {2, 3}}, {ra, {0, 1}}];
(* meeting at A(1/2) = B(1/2) exactly *)
Do[
	Module[{a = 16 RandomInteger[{-2^15, 2^15}, {da + 1, 3}], b = 16 RandomInteger[{-2^15, 2^15}, {db + 1, 3}], t, pa, pb},
		pa = Most[hom[a, ConstantArray[1, da + 1], t] /. t -> 1/2];
		pb = Most[hom[b, ConstantArray[1, db + 1], t] /. t -> 1/2];
		b = (# + pa - pb) & /@ b;
		AppendTo[cases, {da, 0, a, ConstantArray[1, da + 1], db, 0, b, ConstantArray[1, db + 1]}]],
	{da, {1, 2, 3}}, {db, {2, 3}}];
Print["/* Generated by 72_exact_curve_hits_3d.wls; do not edit. */"];
Print["typedef struct ref_exact_curve_hits_3d { int da, ra; long long acp[4 * 3]; long long aw[4]; int db, rb; long long bcp[4 * 3]; long long bw[4]; int n; char const* s[12]; char const* r[12]; int sdy[12]; int rdy[12]; } ref_exact_curve_hits_3d;"];
Print["static ref_exact_curve_hits_3d const g_ref_exact_curve_hits_3d[] = {"];
Do[
	Module[{da = cs[[1]], ra = cs[[2]], acp = cs[[3]], aw = cs[[4]], db = cs[[5]], rb = cs[[6]], bcp = cs[[7]], bw = cs[[8]], s, r, A, B, sols, list},
		A = hom[acp, aw, s];
		B = hom[bcp, bw, r];
		sols = Solve[Join[Table[Expand[A[[c]] B[[4]] - B[[c]] A[[4]]] == 0, {c, 3}], {0 <= s <= 1, 0 <= r <= 1}], {s, r}, Reals];
		list = If[sols === {}, {}, SortBy[DeleteDuplicates[RootReduce[{s, r} /. sols]], N[#[[1]]] &]];
		Print["\t{ ", da, ", ", ra, ", { ", StringRiffle[ToString /@ Flatten[acp], ", "], " }, { ", StringRiffle[ToString /@ aw, ", "], " }, ",
			db, ", ", rb, ", { ", StringRiffle[ToString /@ Flatten[bcp], ", "], " }, { ", StringRiffle[ToString /@ bw, ", "], " }, ", Length[list], ", { ",
			If[list === {}, "0", StringRiffle["\"" <> fmt[#[[1]]] <> "\"" & /@ list, ", "]], " }, { ",
			If[list === {}, "0", StringRiffle["\"" <> fmt[#[[2]]] <> "\"" & /@ list, ", "]], " }, { ",
			If[list === {}, "0", StringRiffle[ToString[If[dyadicQ[#[[1]]], 1, 0]] & /@ list, ", "]], " }, { ",
			If[list === {}, "0", StringRiffle[ToString[If[dyadicQ[#[[2]]], 1, 0]] & /@ list, ", "]], " } },"]],
	{cs, cases}];
Print["};"];
