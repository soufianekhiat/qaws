(* Ground truth for tests/65_exact_bezier.c: exact C^(k)(t), k = 0..3, of
   Bezier and rational Bezier curves with integer lattice control points
   and integer weights, at t = T / 2^8 (endpoints included).

   C(t) = sum B_i(t) w_i P_i / sum B_i(t) w_i, B_i the Bernstein basis;
   derivatives are symbolic. Each row gives the reduced fraction p/q of
   every component. Coordinates are lattice integers (the C test feeds
   them as i 2^-10 world units with space_exp2 = -10).
   Run: wolframscript -file 65_exact_bezier.wls > 65_exact_bezier.h *)
SeedRandom[6565];
P = 8;
bern[n_, i_, t_] := Binomial[n, i] t^i (1 - t)^(n - i);
curve[cp_, w_, t_] := Module[{n = Length[cp] - 1}, Sum[bern[n, i, t] w[[i + 1]] cp[[i + 1]], {i, 0, n}]/Sum[bern[n, i, t] w[[i + 1]], {i, 0, n}]];
cases = Flatten[Table[
	Module[{cp = RandomInteger[{-2^20, 2^20}, {d + 1, dim}], w = If[rat == 1, RandomInteger[{1, 1000}, d + 1], ConstantArray[1, d + 1]],
			Ts = {0, RandomInteger[{1, 2^P - 1}], RandomInteger[{1, 2^P - 1}], 2^P}},
		{dim, d, rat, cp, w, Ts}],
	{dim, {2, 3}}, {d, {1, 2, 3, 5, 8, 12, 16}}, {rat, {0, 1}}], 2];
str[x_] := "\"" <> ToString[x] <> "\"";
Print["/* Generated by 65_exact_bezier.wls; do not edit. */"];
Print["typedef struct ref_exact_bezier { int dim, degree, rational; long long cp[17 * 3]; long long w[17]; long long T; int k; char const* num[3]; char const* den[3]; } ref_exact_bezier;"];
Print["static ref_exact_bezier const g_ref_exact_bezier[] = {"];
Do[
	Module[{dim = cs[[1]], d = cs[[2]], rat = cs[[3]], cp = cs[[4]], w = cs[[5]], t, C, vals},
		C = curve[cp, w, t];
		Do[
			Do[
				vals = D[C, {t, k}] /. t -> T/2^P;
				Print["\t{ ", dim, ", ", d, ", ", rat, ", { ", StringRiffle[ToString /@ Flatten[cp], ", "], " }, { ",
					StringRiffle[ToString /@ w, ", "], " }, ", T, ", ", k, ", { ",
					StringRiffle[str[Numerator[#]] & /@ vals, ", "], If[dim == 2, ", \"0\"", ""], " }, { ",
					StringRiffle[str[Denominator[#]] & /@ vals, ", "], If[dim == 2, ", \"1\"", ""], " } },"],
				{k, 0, 3}],
			{T, cs[[6]]}]],
	{cs, cases}];
Print["};"];
