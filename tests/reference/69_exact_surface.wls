(* Ground truth for tests/69_exact_surface.c: exact partial derivatives
   S, Su, Sv, Suu, Suv, Svv and the normal Su x Sv of Bezier, B-spline and
   NURBS surfaces with integer lattice control points, integer weights and
   integer knots in [0, 8] (repeated interior knots included), at
   (u, v) = (U, V) / 64.

   On the knot rectangle holding (u, v) (lower ends inclusive, the last
   span at the domain end) the basis is the Cox-de Boor recursion with
   N_(i,0) = [i == s], so S is one rational expression there; derivatives
   are symbolic. Values are in lattice units (the normal in squared lattice
   units), as reduced fractions p/q per component.
   Run: wolframscript -file 69_exact_surface.wls > 69_exact_surface.h *)
SeedRandom[6969];
findSpan[knots_, p_, n_, t_] := Module[{s},
	s = Select[Range[p, n - 1], knots[[# + 1]] <= t < knots[[# + 2]] &];
	If[s === {}, Max[Select[Range[p, n - 1], knots[[# + 1]] < knots[[# + 2]] &]], First[s]]];
basisOn[knots_, p_, n_, s_, t_] := Module[{nb},
	nb[i_, 0] := If[i == s, 1, 0];
	nb[i_, k_] := nb[i, k] = Module[{a = knots[[i + k + 1]] - knots[[i + 1]], b = knots[[i + k + 2]] - knots[[i + 2]]},
		Expand[If[a == 0, 0, (t - knots[[i + 1]])/a nb[i, k - 1]] + If[b == 0, 0, (knots[[i + k + 2]] - t)/b nb[i + 1, k - 1]]]];
	Table[nb[i, p], {i, 0, n - 1}]];
mkKnots[p_, n_] := Module[{inner},
	inner = Sort[RandomInteger[{1, 7}, n - p - 1]];
	inner = Flatten[Take[#, UpTo[p]] & /@ Split[inner]];
	While[Length[inner] < n - p - 1, inner = Sort[Append[inner, RandomInteger[{1, 7}]]]; inner = Flatten[Take[#, UpTo[p]] & /@ Split[inner]]];
	Join[ConstantArray[0, p + 1], inner, ConstantArray[8, p + 1]]];
(* kind 0 Bezier, 1 B-spline, 2 NURBS *)
cases = Join[
	Table[{0, pq[[1]], pq[[2]], pq[[1]] + 1, pq[[2]] + 1}, {pq, {{1, 1}, {2, 3}, {3, 3}, {5, 4}}}],
	Flatten[Table[{kind, pq[[1]], pq[[2]], pq[[1]] + 1 + RandomInteger[{1, 3}], pq[[2]] + 1 + RandomInteger[{1, 3}]},
		{kind, {1, 2}}, {pq, {{1, 2}, {2, 2}, {3, 2}, {3, 3}}}], 1]];
cases = Module[{kind = #[[1]], p = #[[2]], q = #[[3]], nu = #[[4]], nv = #[[5]], ku, kv, cp, w},
	ku = If[kind == 0, Join[ConstantArray[0, p + 1], ConstantArray[1, p + 1]], mkKnots[p, nu]];
	kv = If[kind == 0, Join[ConstantArray[0, q + 1], ConstantArray[1, q + 1]], mkKnots[q, nv]];
	cp = RandomInteger[{-2^20, 2^20}, {nu, nv, 3}];
	w = If[kind == 2, RandomInteger[{1, 1000}, {nu, nv}], ConstantArray[1, {nu, nv}]];
	{kind, p, q, nu, nv, ku, kv, cp, w}] & /@ cases;
str[x_] := "\"" <> ToString[x] <> "\"";
Print["/* Generated by 69_exact_surface.wls; do not edit. */"];
Print["typedef struct ref_exact_surface_case { int kind, p, q, nu, nv; long long ku[16]; long long kv[16]; long long cp[8 * 8 * 3]; long long w[8 * 8]; } ref_exact_surface_case;"];
Print["typedef struct ref_exact_surface_row { int c; long long U, V; int which; char const* num[3]; char const* den[3]; } ref_exact_surface_row;"];
Print["static ref_exact_surface_case const g_ref_exact_surface_cases[] = {"];
Do[Print["\t{ ", cs[[1]], ", ", cs[[2]], ", ", cs[[3]], ", ", cs[[4]], ", ", cs[[5]], ", { ", StringRiffle[ToString /@ cs[[6]], ", "], " }, { ",
	StringRiffle[ToString /@ cs[[7]], ", "], " }, { ", StringRiffle[ToString /@ Flatten[cs[[8]]], ", "], " }, { ",
	StringRiffle[ToString /@ Flatten[cs[[9]]], ", "], " } },"], {cs, cases}];
Print["};"];
Print["static ref_exact_surface_row const g_ref_exact_surface_rows[] = {"];
Do[
	Module[{cs = cases[[ci]], kind, p, q, nu, nv, ku, kv, cp, w, umax, vmax, samples, u, v},
		{kind, p, q, nu, nv, ku, kv, cp, w} = cs;
		umax = 64 Last[ku]; vmax = 64 Last[kv];
		samples = Union[{{0, 0}, {umax, vmax}, {umax, 0}}, Table[{RandomInteger[{1, umax - 1}], RandomInteger[{1, vmax - 1}]}, {4}],
			If[kind == 0, {}, {{64 ku[[p + 2]], 64 kv[[q + 2]]}}]];
		Do[
			Module[{su = findSpan[ku, p, nu, smp[[1]]/64], sv = findSpan[kv, q, nv, smp[[2]]/64], Bu, Bv, X, W, S, vals},
				Bu = basisOn[ku, p, nu, su, u];
				Bv = basisOn[kv, q, nv, sv, v];
				X = Sum[Bu[[i]] Bv[[j]] w[[i, j]] cp[[i, j]], {i, nu}, {j, nv}];
				W = Sum[Bu[[i]] Bv[[j]] w[[i, j]], {i, nu}, {j, nv}];
				S = X/W;
				vals = {S, D[S, u], D[S, v], D[S, {u, 2}], D[S, u, v], D[S, {v, 2}], Cross[D[S, u], D[S, v]]} /. {u -> smp[[1]]/64, v -> smp[[2]]/64};
				vals = Together /@ # & /@ vals;
				Do[Print["\t{ ", ci - 1, ", ", smp[[1]], ", ", smp[[2]], ", ", k - 1, ", { ",
					StringRiffle[str[Numerator[#]] & /@ vals[[k]], ", "], " }, { ",
					StringRiffle[str[Denominator[#]] & /@ vals[[k]], ", "], " } },"], {k, 7}]],
			{smp, samples}]],
	{ci, Length[cases]}];
Print["};"];
