#!/usr/bin/env wolframscript
(* Test 114's ground truth: the surfaces' fractional Sobolev metric
   A = B + B0 of Repulsive Surfaces (Sec. 3.2, Eqs. 12 and 13) from its
   definition as a bilinear form over ordered pairs of distinct faces; the
   entries as mixed derivatives d^2 form / du_i dv_j, not from any
   assembly rule. s = 2 - 2/p, sigma = s - 1. Writes 114_repulsive_mesh_metric.h. *)

face[X_, t_] := Module[{xi = X[[t[[1]]]], xj = X[[t[[2]]]], xk = X[[t[[3]]]], m, a},
  m = Cross[xj - xi, xk - xi]; a = Sqrt[m.m]/2;
  {a, m/(2 a), (xi + xj + xk)/3}];

(* D u on the face (i, j, k): N x (u_i e_jk + u_j e_ki + u_k e_ij) / (2a) *)
grad[X_, t_, u_] := Module[{f = face[X, t], xi = X[[t[[1]]]], xj = X[[t[[2]]]], xk = X[[t[[3]]]]},
  Cross[f[[2]], u[t[[1]]] (xk - xj) + u[t[[2]]] (xi - xk) + u[t[[3]]] (xj - xi)]/(2 f[[1]])];

metric[X_, tris_, p_] := Module[{n = Length[X], s = 2 - 2/p, sig, u, v, form = 0},
  sig = s - 1;
  Do[If[S != T,
    Module[{fS = face[X, tris[[S]]], fT = face[X, tris[[T]]], d, r2, w, K2, ub},
     d = fS[[3]] - fT[[3]]; r2 = d.d;
     w = fS[[1]] fT[[1]]/r2^(sig + 1);
     K2 = (fS[[2]].d)^2/r2^2;
     ub[f_, t_] := (f[t[[1]]] + f[t[[2]]] + f[t[[3]]])/3;
     form += w (grad[X, tris[[S]], u] - grad[X, tris[[T]], u]).(grad[X, tris[[S]], v] - grad[X, tris[[T]], v]) +
       w K2 (ub[u, tris[[S]]] - ub[u, tris[[T]]]) (ub[v, tris[[S]]] - ub[v, tris[[T]]])]],
   {S, Length[tris]}, {T, Length[tris]}];
  N[Table[D[form, u[i], v[j]], {i, n}, {j, n}], 30]];

cs[v_] := ToString[CForm[N[v, 20]]];
emit[tag_, X_, tris_, p_] := StringJoin[
  "static double const g114_" <> tag <> "_x[" <> ToString[Length[Flatten[X]]] <> "] = { " <> StringRiffle[cs /@ Flatten[X], ", "] <> " };\n",
  "static unsigned int const g114_" <> tag <> "_idx[" <> ToString[Length[Flatten[tris]]] <> "] = { " <> StringRiffle[ToString /@ Flatten[tris - 1], ", "] <> " };\n",
  "static double const g114_" <> tag <> "_p = " <> cs[p] <> ";\n",
  With[{A = metric[X, tris, p]}, "static double const g114_" <> tag <> "_A[" <> ToString[Length[Flatten[A]]] <> "] = { " <> StringRiffle[cs /@ Flatten[A], ", "] <> " };\n\n"]];

(* an open patch of three faces, and a perturbed octahedron *)
m1x = {{0, 0, 0}, {1, 0, 1/10}, {0, 1, 0}, {1, 1, 3/10}, {2, 1/2, 0}};
m1f = {{1, 2, 3}, {2, 4, 3}, {2, 5, 4}};
m2x = {{1, 0, 0}, {-1, 1/10, 0}, {0, 1, 1/20}, {1/10, -1, 0}, {0, 0, 1}, {-1/20, 1/10, -1}};
m2f = {{1, 3, 5}, {3, 2, 5}, {2, 4, 5}, {4, 1, 5}, {3, 1, 6}, {2, 3, 6}, {4, 2, 6}, {1, 4, 6}};
Export[FileNameJoin[{DirectoryName[$InputFileName], "114_repulsive_mesh_metric.h"}],
  StringJoin["/* generated by 114_repulsive_mesh_metric.wls: the surfaces' metric A = B + B0 (Repulsive Surfaces, Sec. 3.2) from its bilinear form */\n\n",
   emit["m1", m1x, m1f, 6], emit["m2", m2x, m2f, 11/2]], "Text"];
Print["done"];
