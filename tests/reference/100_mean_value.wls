(* Ground truth for tests/100_mean_value.c: mean value coordinates over
   curved regions, at 30 digits.

   The transfinite mean value interpolant of f at x (Dyken and Floater
   2009), over boundary loops c (outside counter-clockwise, holes
   clockwise):
     g(x) = Integral f(c) k dt / Integral k dt,
     k = Cross(c - x, c') / |c - x|^3.
   A handle's coordinate is the same with f its basis function (Bernstein
   for the cubic Beziers below, a handle shared by two curves summing both).

   Shapes, exact rationals:
     blob: four cubic Beziers (the curved test of tests/99_skeleton.c);
     ellipse: centre (1/10, -1/5), radii 3/2 and 4/5, turned by 3/10;
     disc: the unit circle with the square hole [-1/5, 1/5]^2.
   Run: wolframscript -file 100_mean_value.wls > 100_mean_value.h *)
fmt[v_] := Module[{m, x}, {m, x} = MantissaExponent[N[v, 20]]; If[v == 0, "0.0", ToString[NumberForm[N[m, 18], 17]] <> "e" <> ToString[x]]];
row[name_, l_] := Print["static double const " <> name <> "[] = { " <> StringRiffle[fmt /@ N[Flatten[{l}], 30], ", "] <> " };"];
Print["/* Generated by tests/reference/100_mean_value.wls (Mathematica, 30 digits). */"];
cross[a_, b_] := a[[1]] b[[2]] - a[[2]] b[[1]];
kern[c_, dc_, x_] := cross[c - x, dc] / Sqrt[(c - x) . (c - x)]^3;
nint[e_, {t_, a_, b_}] := NIntegrate[e, {t, a, b}, WorkingPrecision -> 40, PrecisionGoal -> 25, MaxRecursion -> 40];

(* ------------------------------------------------------------- blob *)
blob = {{{0, 0}, {1, -9/10}, {12/5, -1/2}, {11/5, 3/5}},
        {{11/5, 3/5}, {2, 8/5}, {7/5, 11/10}, {1, 1}},
        {{1, 1}, {3/5, 9/10}, {1/5, 9/5}, {-1/2, 6/5}},
        {{-1/2, 6/5}, {-6/5, 3/5}, {-3/5, 1/5}, {0, 0}}};
bern[j_, t_] := Binomial[3, j] t^j (1 - t)^(3 - j);
(* handle of curve k (0-based), control point j: the loop's points in order, shared ends once *)
hid[k_, j_] := Mod[3 k + j, 12];
blobCoords[x_] := Module[{acc = ConstantArray[0, 12], tot},
  Do[Module[{c = Sum[bern[j, t] blob[[k + 1, j + 1]], {j, 0, 3}], dc},
      dc = D[c, t];
      Do[acc[[hid[k, j] + 1]] += nint[bern[j, t] kern[c, dc, x], {t, 0, 1}], {j, 0, 3}]],
    {k, 0, 3}];
  tot = Total[acc];
  acc / tot];
blobPts = {{1, 3/10}, {6/5, 21/20}, {1/20, 1/50}, {21/10, 11/20}};
row["ref_blob_points", blobPts];
row["ref_blob_coords", blobCoords /@ blobPts];

(* ---------------------------------------------------------- ellipse *)
fEll[p_] := p[[1]]^2 - p[[2]] + p[[1]] p[[2]]^3;
ell[t_] := {1/10, -1/5} + {{Cos[3/10], -Sin[3/10]}, {Sin[3/10], Cos[3/10]}} . {3/2 Cos[t], 4/5 Sin[t]};
interp[loops_, f_, x_] := Module[{num = 0, den = 0},
  Do[Module[{c = l[[1]], a = l[[2]], b = l[[3]], dc, k},
      dc = D[c, t];
      k = kern[c, dc, x];
      num += nint[f[c] k, {t, a, b}];
      den += nint[k, {t, a, b}]],
    {l, loops}];
  num / den];
ellPts = {{3/10, 0}, {13/10, 1/10}, {-6/5, -2/5}};
row["ref_ellipse_points", ellPts];
row["ref_ellipse_values", interp[{{ell[t], 0, 2 Pi}}, fEll, #] & /@ ellPts];

(* ---------------------------------------------- disc with a square hole *)
fDisc[p_] := Sin[2 p[[1]]] + p[[2]]^2;
seg[a_, b_] := {a + t (b - a), 0, 1};
discLoops = {{{Cos[t], Sin[t]}, 0, 2 Pi},
  seg[{-1/5, -1/5}, {-1/5, 1/5}], seg[{-1/5, 1/5}, {1/5, 1/5}], seg[{1/5, 1/5}, {1/5, -1/5}], seg[{1/5, -1/5}, {-1/5, -1/5}]};
discPts = {{1/2, 1/10}, {-7/10, -3/5}, {0, 9/10}};
row["ref_disc_points", discPts];
row["ref_disc_values", interp[discLoops, fDisc, #] & /@ discPts];
