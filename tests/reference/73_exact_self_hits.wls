(* Ground truth for tests/73_exact_self_hits.c: self-intersections C(a) = C(b),
   a < b, of Bezier / rational Bezier curves (one span) and B-spline / NURBS
   curves (several spans), in 2D and 3D.

   Span against itself: the divided differences
   (X(s) W(t) - X(t) W(s)) / (s - t) (and Y, Z) vanish, t < s; span against
   another span: the homogeneous equations X_i(t) W_j(s) - X_j(s) W_i(t) = 0.
   Knots are integers (spans on [k_i, k_i+1]); global parameters are listed
   as 25-digit decimals with dyadic flags, deduplicated (a knot point once).
   Coordinates are lattice integers (2^-10 world units).
   Run: wolframscript -file 73_exact_self_hits.wls > 73_exact_self_hits.h *)
SeedRandom[7373];
dyadicQ[r0_] := Module[{r = RootReduce[r0]}, IntegerQ[r] || (Head[r] === Rational && Denominator[r] == 2^(IntegerLength[Denominator[r], 2] - 1))];
fmt[r_] := If[r == 0, "0", Module[{m, e}, {m, e} = MantissaExponent[N[r, 40]]; ToString[Round[m 10^25]] <> "e" <> ToString[e - 25]]];
basisOn[knots_, p_, n_, s_, t_] := Module[{nb},
	nb[i_, 0] := If[i == s, 1, 0];
	nb[i_, k_] := nb[i, k] = Module[{a = knots[[i + k + 1]] - knots[[i + 1]], b = knots[[i + k + 2]] - knots[[i + 2]]},
		Expand[If[a == 0, 0, (t - knots[[i + 1]])/a nb[i, k - 1]] + If[b == 0, 0, (knots[[i + k + 2]] - t)/b nb[i + 1, k - 1]]]];
	Table[nb[i, p], {i, 0, n - 1}]];
(* homogeneous coordinates of span s as polynomials in t *)
homOn[knots_, p_, cp_, w_, s_, t_] := Module[{n = Length[cp], B, dim = Length[cp[[1]]]},
	B = basisOn[knots, p, n, s, t];
	Append[Table[Expand[Sum[B[[i]] w[[i]] cp[[i, c]], {i, n}]], {c, dim}], Expand[Sum[B[[i]] w[[i]], {i, n}]]]];
selfHits[knots_, p_, cp_, w_] := Module[{n = Length[cp], dim = Length[cp[[1]]], spans, res = {}, t, s},
	spans = Select[Range[p, n - 1], knots[[# + 1]] < knots[[# + 2]] &];
	Do[
		Module[{Hi = homOn[knots, p, cp, w, si, t], Hj = homOn[knots, p, cp, w, sj, s], eqs, sols},
			If[si == sj,
				eqs = Table[Together[(Hi[[c]] (Hi[[dim + 1]] /. t -> s) - (Hi[[c]] /. t -> s) Hi[[dim + 1]])/(t - s)] == 0, {c, dim}];
				sols = Solve[Join[eqs, {knots[[si + 1]] <= t < s <= knots[[si + 2]]}], {t, s}, Reals],
				eqs = Table[Expand[Hi[[c]] Hj[[dim + 1]] - Hj[[c]] Hi[[dim + 1]]] == 0, {c, dim}];
				sols = Solve[Join[eqs, {knots[[si + 1]] <= t <= knots[[si + 2]], knots[[sj + 1]] <= s <= knots[[sj + 2]], t < s}], {t, s}, Reals]];
			If[sols =!= {}, res = Join[res, RootReduce[{t, s} /. sols]]]],
		{si, spans}, {sj, Select[spans, # >= si &]}];
	(* the closing point of a closed curve is not a self-intersection *)
	Module[{t0 = knots[[p + 1]], t1 = knots[[n + 1]], P0, P1},
		P0 = homOn[knots, p, cp, w, First[spans], t] /. t -> t0;
		P1 = homOn[knots, p, cp, w, Last[spans], t] /. t -> t1;
		If[Most[P0]/Last[P0] == Most[P1]/Last[P1], res = Select[res, !(#[[1]] == t0 && #[[2]] == t1) &]]];
	SortBy[DeleteDuplicates[res], N]];
clamped[p_, n_] := Join[ConstantArray[0, p + 1], Range[1, n - p - 1], ConstantArray[n - p, p + 1]];
cases = {};
(* single spans, 2D: knots of a Bezier *)
Do[
	Module[{cp = RandomInteger[{-2^18, 2^18}, {d + 1, 2}], w = If[rat == 1, RandomInteger[{1, 30}, d + 1], ConstantArray[1, d + 1]]},
		AppendTo[cases, {0, 2, d, rat, cp, w, clamped[d, d + 1]}]],
	{d, {3, 3, 3, 4, 4, 5}}, {rat, {0, 1}}, {rep, 3}];
(* a classic loop *)
AppendTo[cases, {0, 2, 3, 0, {{0, 0}, {300000, 300000}, {-100000, 300000}, {200000, 0}}, {1, 1, 1, 1}, clamped[3, 4]}];
(* 3D: loops lifted into a plane, and random space curves *)
Do[
	Module[{cp2 = RandomInteger[{-2^17, 2^17}, {d + 1, 2}], al = RandomInteger[{-2, 2}], be = RandomInteger[{-2, 2}]},
		AppendTo[cases, {0, 3, d, 0, {#[[1]], #[[2]], al #[[1]] + be #[[2]]} & /@ cp2, ConstantArray[1, d + 1], clamped[d, d + 1]}]],
	{d, {3, 4}}, {rep, 3}];
Do[AppendTo[cases, {0, 3, 3, 0, RandomInteger[{-2^18, 2^18}, {4, 3}], ConstantArray[1, 4], clamped[3, 4]}], {rep, 3}];
(* B-splines and NURBS, 2D *)
Do[
	Module[{n = 7, cp = RandomInteger[{-2^18, 2^18}, {7, 2}], w = If[rat == 1, RandomInteger[{1, 20}, 7], ConstantArray[1, 7]]},
		AppendTo[cases, {1, 2, p, rat, cp, w, clamped[p, n]}]],
	{p, {1, 2, 3}}, {rat, {0, 1}}, {rep, 2}];
(* a closed B-spline (first and last control points equal) *)
AppendTo[cases, {1, 2, 2, 0, {{0, 0}, {400000, -200000}, {500000, 300000}, {-100000, 200000}, {300000, -100000}, {100000, 400000}, {0, 0}}, ConstantArray[1, 7], clamped[2, 7]}];
Print["/* Generated by 73_exact_self_hits.wls; do not edit. */"];
Print["typedef struct ref_exact_self_hits { int kind, dim, degree, rational, n; long long cp[8 * 3]; long long w[8]; long long knots[16]; int nk; int count; char const* a[24]; char const* b[24]; int ady[24]; int bdy[24]; } ref_exact_self_hits;"];
Print["static ref_exact_self_hits const g_ref_exact_self_hits[] = {"];
Do[
	Module[{kind = cs[[1]], dim = cs[[2]], p = cs[[3]], rat = cs[[4]], cp = cs[[5]], w = cs[[6]], kn = cs[[7]], list},
		list = selfHits[kn, p, cp, w];
		Print["\t{ ", kind, ", ", dim, ", ", p, ", ", rat, ", ", Length[cp], ", { ", StringRiffle[ToString /@ Flatten[cp], ", "], " }, { ",
			StringRiffle[ToString /@ w, ", "], " }, { ", StringRiffle[ToString /@ kn, ", "], " }, ", Length[kn], ", ", Length[list], ", { ",
			If[list === {}, "0", StringRiffle["\"" <> fmt[#[[1]]] <> "\"" & /@ list, ", "]], " }, { ",
			If[list === {}, "0", StringRiffle["\"" <> fmt[#[[2]]] <> "\"" & /@ list, ", "]], " }, { ",
			If[list === {}, "0", StringRiffle[ToString[If[dyadicQ[#[[1]]], 1, 0]] & /@ list, ", "]], " }, { ",
			If[list === {}, "0", StringRiffle[ToString[If[dyadicQ[#[[2]]], 1, 0]] & /@ list, ", "]], " } },"]],
	{cs, cases}];
Print["};"];
