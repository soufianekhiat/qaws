(* Ground truth for tests/55_diff_maps.c: maps of geometry-building
   operations, at 30 digits.

   Bezier split at s (inputs: control points and s; outputs: the control
   points of both halves, from the de Casteljau polynomials in s):
     L_j = sum_{i <= j} C(j, i) s^i (1 - s)^(j - i) P_i,
     R_j = sum_{i <= n - j} C(n - j, i) s^i (1 - s)^(n - j - i) P_(j + i).

   Least-squares B-spline fit (qaws_curve_fit_bspline: m data points, n
   control points, degree 3): chord-length parameters (or given ones),
   averaged interior knots
     knot[p + j] = (1 - a) t[i - 1] + a t[i],  j d = i + a,  d = (m - 1) / (n - p),
   endpoints interpolated, interior control points from the normal
   equations over the interior data points. Every input moves as
   x0 + e xdot; the parameters, knots, Cox-de Boor bases (spans frozen at
   e = 0) and normal equations are carried as first order series in e and
   the solve is differentiated as Q' = A^-1 (b' - A' Q). The tangent is the
   e coefficient along the direction; the adjoint of an output weight is
   the tangent of <weight, output> along every unit input direction.
   Exact rationals: direction[k] = (((7 k + 3) mod 11) - 5) / 10 over the
   inputs (parameters: (((3 k + 1) mod 7) - 3) / 10, ends fixed), weights
   (((5 k + 2) mod 9) - 4) / 10 over control points and (((2 k + 1) mod 5) - 2) / 10
   over knots / the right half.
   Run: wolframscript -file 55_maps.wls > 55_maps.h *)
fmt[v_] := Module[{m, x}, {m, x} = MantissaExponent[N[v, 20]]; If[v == 0, "0.0", ToString[NumberForm[N[m, 18], 17]] <> "e" <> ToString[x]]];
row[name_, l_] := Print["static double const " <> name <> "[] = { " <> StringRiffle[fmt /@ N[Flatten[{l}], 30], ", "] <> " };"];
Print["/* Generated by tests/reference/55_maps.wls (Mathematica, 30 digits). */"];
dirOf[n_] := Table[(Mod[7 k + 3, 11] - 5)/10, {k, 0, n - 1}];
wQ[n_] := Table[(Mod[5 k + 2, 9] - 4)/10, {k, 0, n - 1}];
wK[n_] := Table[(Mod[2 k + 1, 5] - 2)/10, {k, 0, n - 1}];
d1[expr_] := D[expr, e] /. e -> 0;

(* ------------------------------------------------------------- split *)
PS = {{1/5, -3/10, 1/2}, {1, 1/2, -1/5}, {3/2, -1/2, 3/10}, {5/2, 3/5, 0}, {3, -1/5, -2/5}, {4, 1/10, 1/5}};
s0 = 37/100;
split[P_, s_] := Module[{n = Length[P] - 1},
  {Table[Sum[Binomial[j, i] s^i (1 - s)^(j - i) P[[i + 1]], {i, 0, j}], {j, 0, n}],
   Table[Sum[Binomial[n - j, i] s^i (1 - s)^(n - j - i) P[[j + i + 1]], {i, 0, n - j}], {j, 0, n}]}];
Module[{dP = Partition[dirOf[18], 3], ds = 4/5, out, tg, wl = wQ[18], wr = wK[18], f},
  out = split[PS, s0];
  tg = d1[split[PS + e dP, s0 + e ds]];
  f[P_, s_] := Module[{lr = split[P, s]}, wl . Flatten[lr[[1]]] + wr . Flatten[lr[[2]]]];
  row["ref_split_value", out];
  row["ref_split_tangent", tg];
  row["ref_split_adjoint", Append[Table[d1[f[PS + e Partition[UnitVector[18, j], 3], s0]], {j, 18}], d1[f[PS, s0 + e]]]]];

(* --------------------------------------------------------------- fit *)
coxDeBoor[kn_, s_, p_, t_] := Module[{b = Table[If[i == s, 1, 0], {i, Length[kn] - 1}]},
  Do[b = Table[
      If[b[[i]] === 0, 0, (t - kn[[i]]) / (kn[[i + d]] - kn[[i]]) b[[i]]] +
      If[b[[i + 1]] === 0, 0, (kn[[i + d + 1]] - t) / (kn[[i + d + 1]] - kn[[i + 1]]) b[[i + 1]]],
      {i, Length[b] - 1}],
    {d, 1, p}];
  b];
at0[x_] := Normal[x] /. e -> 0;
(* fit of data Dd (m x dim, entries x0 + e x1 + O[e]^2), parameters Tt or None *)
fit[Dd_, Tt_, n_] := Module[{m = Length[Dd], p = 3, t, cum, kn, dd, A, b, A0, A1, b0, b1, Q0, Q1, rows},
  If[Tt === None,
    cum = Accumulate[Table[Sqrt[(Dd[[i]] - Dd[[i - 1]]) . (Dd[[i]] - Dd[[i - 1]])], {i, 2, m}]];
    t = Join[{0}, Most[cum / Last[cum]], {1}],
    t = Tt];
  dd = (m - 1)/(n - p);
  kn = Join[ConstantArray[0, p + 1],
    Table[Module[{ii = Floor[j dd], a}, a = j dd - ii; (1 - a) t[[ii]] + a t[[ii + 1]]], {j, 1, n - p - 1}],
    ConstantArray[1, p + 1]];
  rows = Table[Module[{s = Last[Flatten[Position[at0 /@ kn, k_ /; k <= at0[t[[k1]]]]]]},
      s = Min[s, n];   (* t = 1 lies in the last span *)
      coxDeBoor[kn, s, p, t[[k1]]]], {k1, 2, m - 1}];
  A = Sum[Outer[Times, rows[[k, 2 ;; n - 1]], rows[[k, 2 ;; n - 1]]], {k, m - 2}];
  b = Sum[Outer[Times, rows[[k, 2 ;; n - 1]], Dd[[k + 1]] - rows[[k, 1]] Dd[[1]] - rows[[k, n]] Dd[[m]]], {k, m - 2}];
  A0 = at0 /@ A; b0 = at0 /@ b;
  A1 = Map[Coefficient[Normal[#], e, 1] &, A, {2}]; b1 = Map[Coefficient[Normal[#], e, 1] &, b, {2}];
  Q0 = LinearSolve[A0, b0]; Q1 = LinearSolve[A0, b1 - A1 . Q0];
  {Join[{at0 /@ Dd[[1]]}, Q0, {at0 /@ Dd[[m]]}], at0 /@ kn,
   Join[{Coefficient[Normal[#], e, 1] & /@ Dd[[1]]}, Q1, {Coefficient[Normal[#], e, 1] & /@ Dd[[m]]}],
   Coefficient[Normal[#], e, 1] & /@ kn}];
ser[x_] := x + O[e]^2;
runFit[tag_, dim_, withParams_] := Module[{m = 14, n = 7, D0, T0, dD, dT, res, wq, wk, along, adjD, adjT},
  D0 = N[Table[Take[{3 i/13 + (Mod[3 i, 5] - 2)/20, (Mod[5 i, 7] - 3)/5, (Mod[2 i, 5] - 2)/10}, dim], {i, 0, m - 1}], 50];
  T0 = N[Table[If[i == 0 || i == m - 1, i/(m - 1), i/(m - 1) + (Mod[4 i, 7] - 3)/200], {i, 0, m - 1}], 50];
  dD = Partition[dirOf[m dim], dim];
  dT = Table[If[k == 0 || k == m - 1, 0, (Mod[3 k + 1, 7] - 3)/10], {k, 0, m - 1}];
  wq = wQ[n dim]; wk = wK[n + 4];
  along[xD_, xT_] := fit[Map[ser, D0 + e xD, {2}], If[withParams, Map[ser, T0 + e xT], None], n];
  res = along[dD, If[withParams, dT, 0]];
  row["ref_" <> tag <> "_value", Join[Flatten[res[[1]]], res[[2]]]];
  row["ref_" <> tag <> "_tangent", Join[Flatten[res[[3]]], res[[4]]]];
  adjD = Table[Module[{r = along[Partition[UnitVector[m dim, j], dim], 0]}, wq . Flatten[r[[3]]] + wk . r[[4]]], {j, m dim}];
  row["ref_" <> tag <> "_adjoint_points", adjD];
  If[withParams,
    adjT = Table[Module[{r = along[ConstantArray[0, {m, dim}], UnitVector[m, j]]}, wq . Flatten[r[[3]]] + wk . r[[4]]], {j, m}];
    row["ref_" <> tag <> "_adjoint_parameters", adjT]]];
runFit["fit2", 2, False];
runFit["fit3", 3, True];
