(* Ground truth for tests/101_surface_geodesic.c: geodesics on a bicubic
   Bezier patch, at 30 digits.

   The patch S(u, v) = sum_ij B_i(u) B_j(v) P_ij (u, v in [0, 1]), its
   metric E, F, G and Christoffel symbols G^k_ij = g^-1 (S_k . S_ij), and the
   geodesic equation by arc length,
     u'' = -(G1_11 u'^2 + 2 G1_12 u' v' + G1_22 v'^2),
     v'' = -(G2_11 u'^2 + 2 G2_12 u' v' + G2_22 v'^2),
   solved by NDSolve (WorkingPrecision 30). A direction at angle a is
   cos a e1 + sin a e2, e1 = (1 / sqrt E, 0), e2 = (-F, E) / sqrt(E (E G - F^2))
   (a quarter turn from S_u about S_u x S_v).
     - exp: the end (u, v) of the geodesic from p at angle a after length L;
     - geodesic between two points: its length (FindRoot on the angle and the
       length of the shot);
     - geodesic circle: points at angles about a centre, radius r.
   Run: wolframscript -file 101_surface_geodesic.wls > 101_surface_geodesic.h *)
fmt[v_] := Module[{m, x}, {m, x} = MantissaExponent[N[v, 20]]; If[v == 0, "0.0", ToString[NumberForm[N[m, 18], 17]] <> "e" <> ToString[x]]];
row[name_, l_] := Print["static double const " <> name <> "[] = { " <> StringRiffle[fmt /@ N[Flatten[{l}], 30], ", "] <> " };"];
Print["/* Generated by tests/reference/101_surface_geodesic.wls (Mathematica, 30 digits). */"];

P = {{{0, 0, 0}, {0, 1/3, 1/5}, {0, 2/3, -1/10}, {0, 1, 0}},
     {{1/3, 0, 1/4}, {1/3, 1/3, 3/5}, {1/3, 2/3, 2/5}, {1/3, 1, 1/10}},
     {{2/3, 0, -1/5}, {2/3, 1/3, 1/2}, {2/3, 2/3, 7/10}, {2/3, 1, 3/10}},
     {{1, 0, 0}, {1, 1/3, -1/10}, {1, 2/3, 1/5}, {1, 1, 0}}};
row["ref_patch", P];
bern[i_, t_] := Binomial[3, i] t^i (1 - t)^(3 - i);
S[u_, v_] := Sum[bern[i, u] bern[j, v] P[[i + 1, j + 1]], {i, 0, 3}, {j, 0, 3}];
Su[u_, v_] = D[S[u, v], u]; Sv[u_, v_] = D[S[u, v], v];
Suu[u_, v_] = D[S[u, v], u, u]; Suv[u_, v_] = D[S[u, v], u, v]; Svv[u_, v_] = D[S[u, v], v, v];
gm[u_, v_] := {Su[u, v] . Su[u, v], Su[u, v] . Sv[u, v], Sv[u, v] . Sv[u, v]};
chr[u_, v_] := Module[{g = gm[u, v], det, a, b, out = {}},
  det = g[[1]] g[[3]] - g[[2]]^2;
  Table[a = Su[u, v] . sij; b = Sv[u, v] . sij; {(g[[3]] a - g[[2]] b)/det, (g[[1]] b - g[[2]] a)/det},
    {sij, {Suu[u, v], Suv[u, v], Svv[u, v]}}]];
dirAt[p_, a_] := Module[{g = gm @@ p, det}, det = g[[1]] g[[3]] - g[[2]]^2;
  Cos[a] {1/Sqrt[g[[1]]], 0} + Sin[a] {-g[[2]], g[[1]]}/Sqrt[g[[1]] det]];
shoot[p_, a_, L_] := Module[{d = dirAt[p, a], sol},
  sol = NDSolve[{
      u''[s] == -(First[chr[u[s], v[s]][[1]]] u'[s]^2 + 2 First[chr[u[s], v[s]][[2]]] u'[s] v'[s] + First[chr[u[s], v[s]][[3]]] v'[s]^2),
      v''[s] == -(Last[chr[u[s], v[s]][[1]]] u'[s]^2 + 2 Last[chr[u[s], v[s]][[2]]] u'[s] v'[s] + Last[chr[u[s], v[s]][[3]]] v'[s]^2),
      u[0] == p[[1]], v[0] == p[[2]], u'[0] == d[[1]], v'[0] == d[[2]]},
    {u, v}, {s, 0, L}, WorkingPrecision -> 30, PrecisionGoal -> 22, AccuracyGoal -> 22, MaxSteps -> Infinity];
  {u[L], v[L]} /. First[sol]];

(* exp at three (p, angle, length) *)
expIn = {{{3/10, 2/5}, 1/2, 3/5}, {{1/2, 1/2}, 2, 2/5}, {{7/10, 3/10}, -2/3, 1/5}};
row["ref_exp_in", Table[{e[[1]], e[[2]], e[[3]]}, {e, expIn}]];
row["ref_exp_out", Table[shoot[e[[1]], e[[2]], e[[3]]], {e, expIn}]];

(* a geodesic between two points: its length *)
pa = {1/5, 3/10}; pb = {4/5, 7/10};
resid[a_?NumericQ, L_?NumericQ] := shoot[pa, a, L] - pb;
geo = FindRoot[resid[aa, LL], {aa, ArcTan[1/2]}, {LL, 1}, WorkingPrecision -> 30, AccuracyGoal -> 20];
row["ref_geodesic_ends", {pa, pb}];
row["ref_geodesic_length", LL /. geo];

(* geodesic circle points: centre, radius, eight angles *)
cc = {1/2, 9/20}; rr = 3/10;
row["ref_circle_centre", {cc, rr}];
row["ref_circle_points", Table[shoot[cc, 2 Pi k/8, rr], {k, 0, 7}]];
