(* Ground truth for tests/50_diff_curves.c: evaluation jets (position, D1,
   D2) of a 2D cubic B-spline and of a 3D cubic NURBS with their control
   points, weights and knots as parameters, at 30 digits.

   The basis is built with the Cox-de Boor recursion on symbolic knots (the
   span holding t at e = 0 is fixed, the knots are distinct), so no
   knot derivative formula is assumed. Along a direction every parameter
   moves as x0 + e xdot and t as t0 + e tdot; the jet
     C = sum w_i N_i P_i / sum w_i N_i,  C', C''  (derivatives in t)
   is expanded in e exactly (Series):
     tangent = d/de, tangent2 = d2/de2 at e = 0.
   The adjoint of a fixed jet weight ybar is the gradient of <ybar, jet>
   with respect to every control point, weight, knot and t.
   Run: wolframscript -file 50_curves.wls > 50_curves.h *)
fmt[v_] := Module[{m, x}, {m, x} = MantissaExponent[N[v, 20]]; If[v == 0, "0.0", ToString[NumberForm[N[m, 18], 17]] <> "e" <> ToString[x]]];
row[name_, l_] := Print["static double const " <> name <> "[] = { " <> StringRiffle[fmt /@ N[Flatten[{l}], 30], ", "] <> " };"];
Print["/* Generated by tests/reference/50_curves.wls (Mathematica, 30 digits). */"];
d12[expr_] := Module[{s = Normal[Series[expr, {e, 0, 2}]]}, {Coefficient[s, e, 1], 2 Coefficient[s, e, 2]}];
d1[expr_] := Coefficient[Normal[Series[expr, {e, 0, 1}]], e, 1];

(* Cox-de Boor: all basis functions of degree p on knots kn, for t in the
   interval [kn[[s]], kn[[s + 1]]] (1-based) *)
coxDeBoor[kn_, s_, p_, t_] := Module[{nb = Length[kn] - 1, b},
  b = Table[If[i == s, 1, 0], {i, nb}];
  Do[b = Table[
      If[b[[i]] === 0, 0, (t - kn[[i]]) / (kn[[i + d]] - kn[[i]]) b[[i]]] +
      If[b[[i + 1]] === 0, 0, (kn[[i + d + 1]] - t) / (kn[[i + d + 1]] - kn[[i + 1]]) b[[i + 1]]],
      {i, Length[b] - 1}],
    {d, 1, p}];
  b];

K0 = {1/10, 3/5, 1, 3/2, 21/10, 13/5, 3, 7/2, 39/10, 22/5, 24/5};
ts = {17/10, 23/10, 33/10};
tdots = {1/2, -1/5, 3/10};
spanOf[t_] := Last[Flatten[Position[K0, k_ /; k <= t]]];
(* jet of the curve for parameters (P, w, kn) at t = t0 + e tdot *)
jet[P_, w_, kn_, s_, tt_] := Module[{b = coxDeBoor[kn, s, 3, t], c},
  c = (b w) . P / (b . w);
  {c, D[c, t], D[c, {t, 2}]} /. t -> tt];
dK = Table[(Mod[4 i + 1, 7] - 3)/20, {i, 0, 10}];

run[tag_, P0_, W0_, dP_, dW_, withWeights_] := Module[{np = Length[Flatten[P0]], dim = Length[P0[[1]]]},
  Do[Module[{t0 = ts[[k]], s = spanOf[ts[[k]]], ybar, tg, adj, unitP},
      ybar = Table[(Mod[3 ch + 2 c + k, 5] - 2)/5, {ch, 0, 2}, {c, 0, dim - 1}];
      tg = Identity[d12[Flatten[jet[P0 + e dP, W0 + If[withWeights, e dW, 0], K0 + e dK, s, t0 + e tdots[[k]]]]]];
      unitP[j_] := Partition[UnitVector[np, j], dim];
      adj = Join[
        Table[d1[Flatten[ybar] . Flatten[jet[P0 + e unitP[j], W0, K0, s, t0]]], {j, np}],
        If[withWeights, Table[d1[Flatten[ybar] . Flatten[jet[P0, W0 + e UnitVector[7, j], K0, s, t0]]], {j, 7}], {}],
        Table[d1[Flatten[ybar] . Flatten[jet[P0, W0, K0 + e UnitVector[11, j], s, t0 ]]], {j, 11}],
        {d1[Flatten[ybar] . Flatten[jet[P0, W0, K0, s, t0 + e]]]}];
      row["ref_" <> tag <> "_value" <> ToString[k - 1], jet[P0, W0, K0, s, t0]];
      row["ref_" <> tag <> "_tangent" <> ToString[k - 1], tg[[1]]];
      row["ref_" <> tag <> "_tangent2_" <> ToString[k - 1], tg[[2]]];
      row["ref_" <> tag <> "_adjoint" <> ToString[k - 1], adj]],
    {k, 3}]];

(* 2D B-spline: control points and knots *)
PB = {{0, 0}, {1, 1}, {2, -1/2}, {3, 3/2}, {4, 0}, {5, 1}, {6, -1}};
dPB = Table[(Mod[3 i + 5 c + 1, 7] - 3)/10, {i, 0, 6}, {c, 0, 1}];
run["bk", PB, ConstantArray[1, 7], dPB, 0, False];

(* 3D NURBS: control points, weights and knots *)
PN = {{0, 0, 0}, {1, 3/2, 1/2}, {2, -1/2, 1}, {3, 1, -1/2}, {4, 2, 0}, {5, -1, 1/2}, {6, 1/2, 1}};
WN = {1, 3/2, 4/5, 6/5, 1, 7/10, 5/4};
dPN = Table[(Mod[3 i + 5 c + 1, 7] - 3)/10, {i, 0, 6}, {c, 0, 2}];
dWN = Table[(Mod[2 i + 1, 5] - 2)/20, {i, 0, 6}];
run["nk", PN, WN, dPN, dWN, True];
