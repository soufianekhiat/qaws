(* Ground truth for tests/58_diff_sampling.c: constant-speed samples of a
   cubic B-spline and their first and second derivatives with respect to
   the control points, at 30 digits.

   The curve is linear in its control points x, so along directions a, b
   the speed s = |C'| has the exact derivatives
     s_a  = C'.C'_a / s
     s_ab = C'_a.C'_b / s - (C'.C'_a)(C'.C'_b) / s^3
   and the sample parameter t solves F(t, x) = L(t, x) - sigma(x) = 0,
   sigma = distance + fraction L_total, so by the implicit function theorem
     t_a  = -F_a / F_t
     t_ab = -(F_ab + F_at t_b + F_bt t_a + F_tt t_a t_b) / F_t
   with F_t = s(t), F_tt = s_t(t), F_at = s_a(t). Positions follow by the
   chain rule. Run: wolframscript -file 58_arc_length.wls > 58_arc_length.h *)
knots = {0, 0, 0, 0, 1, 2, 3, 3, 3, 3};
P0 = {{0, 0, 0}, {1, 2, 1/2}, {5/2, 2, -1/2}, {7/2, 1/2, 1}, {5, 1, 0}, {6, 3, 1/2}};
V = {{1/5, -3/10, 1/10}, {-1/4, 1/5, 3/10}, {1/10, 1/10, -1/5}, {3/10, -1/5, 1/4}, {-1/5, 3/10, -1/10}, {1/10, -1/4, 1/5}};
targets = {{0, 7/20}, {17/10, 0}, {-1/2, 1}};   (* {distance, fraction} *)
adj = {{3/10, {1/2, -1/4, 1/5}}, {-1/5, {-3/10, 2/5, 1/10}}, {1/4, {1/5, 1/5, -2/5}}};  (* {t_bar, p_bar} *)
prec = 30;
(* exact polynomial basis on span k = [k, k + 1] *)
basisSpan[k_] := Table[Simplify[PiecewiseExpand[BSplineBasis[{3, knots}, i - 1, u]], k < u < k + 1], {i, 6}];
B = Table[basisSpan[k], {k, 0, 2}];
spanOf[t_] := Min[Floor[t], 2];
Cs[k_, P_] := B[[k + 1]] . P;            (* expression in u *)
D1s[k_, P_] := D[Cs[k, P], u];
sp[k_] := Sqrt[D1s[k, P0] . D1s[k, P0]];
sa[k_, a_] := D1s[k, P0] . D1s[k, a] / sp[k];
sab[k_, a_, b_] := D1s[k, a] . D1s[k, b] / sp[k] - (D1s[k, P0] . D1s[k, a]) (D1s[k, P0] . D1s[k, b]) / sp[k]^3;
integ[f_, lo_, hi_] := NIntegrate[f, {u, lo, hi}, WorkingPrecision -> prec, PrecisionGoal -> 24, AccuracyGoal -> 26, MaxRecursion -> 20];
(* integral over [0, t] of the span-wise integrand g[k] *)
upto[g_, t_?NumericQ] := Total[Table[integ[g[k], k, Min[k + 1, t]], {k, 0, spanOf[t]}]];
uptoSp[t_?NumericQ] := upto[sp, t];
Ltot = upto[sp, 3];
sol = Table[Module[{sig = targets[[i, 1]] + targets[[i, 2]] Ltot},
  t /. FindRoot[uptoSp[t] == sig, {t, 3 sig / Ltot}, WorkingPrecision -> prec, AccuracyGoal -> 28, PrecisionGoal -> 28]], {i, 3}];
units = Flatten[Table[ReplacePart[ConstantArray[0, {6, 3}], {k, c} -> 1], {k, 6}, {c, 3}], 1];
at[expr_, t0_] := expr /. u -> t0;
derivs[i_, a_, b_] := Module[{t0 = sol[[i]], f = targets[[i, 2]], k, Fa, Fb, Fab, Ft, Ftt, Fat, Fbt, ta, tb, tab, Ct, Ctt, Ca, Cat, Cbt, pa, pab},
  k = spanOf[t0];
  Fa = upto[sa[#, a] &, t0] - f upto[sa[#, a] &, 3];
  Fb = upto[sa[#, b] &, t0] - f upto[sa[#, b] &, 3];
  Fab = upto[sab[#, a, b] &, t0] - f upto[sab[#, a, b] &, 3];
  Ft = at[sp[k], t0];
  Ftt = at[D[sp[k], u], t0];
  Fat = at[sa[k, a], t0]; Fbt = at[sa[k, b], t0];
  ta = -Fa / Ft; tb = -Fb / Ft;
  tab = -(Fab + Fat tb + Fbt ta + Ftt ta tb) / Ft;
  Ct = at[D1s[k, P0], t0];
  Ctt = at[D[D1s[k, P0], u], t0];
  Ca = at[Cs[k, a], t0];
  Cat = at[D1s[k, a], t0]; Cbt = at[D1s[k, b], t0];
  pa = Ca + Ct ta;
  pab = Cat tb + Cbt ta + Ctt ta tb + Ct tab;
  {ta, pa, tab, pab}];
fmt[v_] := Module[{m, e}, {m, e} = MantissaExponent[N[v, 20]]; If[v == 0, "0.0", ToString[NumberForm[N[m, 18], 17]] <> "e" <> ToString[e]]];
row[name_, l_] := Print["static double const " <> name <> "[] = { " <> StringRiffle[fmt /@ Flatten[{l}], ", "] <> " };"];
Print["/* Generated by tests/reference/58_arc_length.wls (Mathematica, 30 digits). */"];
row["ref_total", Ltot];
row["ref_t", sol];
row["ref_p", Table[at[Cs[spanOf[sol[[i]]], P0], sol[[i]]], {i, 3}]];
fw = Table[derivs[i, V, V], {i, 3}];
row["ref_t1", fw[[All, 1]]]; row["ref_p1", fw[[All, 2]]];
row["ref_t2", fw[[All, 3]]]; row["ref_p2", fw[[All, 4]]];
grad = Table[Sum[Module[{d = derivs[i, units[[j]], units[[j]]]}, adj[[i, 1]] d[[1]] + adj[[i, 2]] . d[[2]]], {i, 3}], {j, 18}];
row["ref_grad", grad];
hvp = Table[Sum[Module[{d = derivs[i, V, units[[j]]]}, adj[[i, 1]] d[[3]] + adj[[i, 2]] . d[[4]]], {i, 3}], {j, 18}];
row["ref_hvp", hvp];
