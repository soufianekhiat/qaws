(* Ground truth for tests/58_diff_sampling.c: inverse-CDF samples of a cubic
   B-spline for three measures m = rho |C'| (arc length; curvature
   rho = sqrt(floor^2 + kappa^2); a density rho(C)), and their first and
   second derivatives with respect to the control points, at 30 digits.

   Along directions a, b the control points move as P0 + e1 a + e2 b; the
   integrand m(u; e1, e2) is differentiated symbolically in e1, e2. The
   sample parameter t solves F(t, x) = M(t, x) - sigma(x) = 0,
   sigma = distance + fraction M_total, so by the implicit function theorem
     t_a  = -F_a / F_t
     t_ab = -(F_ab + F_at t_b + F_bt t_a + F_tt t_a t_b) / F_t
   with F_t = m(t), F_tt = m_u(t), F_at = m_a(t). Positions follow by the
   chain rule (C is linear in the control points).
   Run: wolframscript -file 58_arc_length.wls > 58_arc_length.h *)
knots = {0, 0, 0, 0, 1, 2, 3, 3, 3, 3};
P0 = {{0, 0, 0}, {1, 2, 1/2}, {5/2, 2, -1/2}, {7/2, 1/2, 1}, {5, 1, 0}, {6, 3, 1/2}};
V = {{1/5, -3/10, 1/10}, {-1/4, 1/5, 3/10}, {1/10, 1/10, -1/5}, {3/10, -1/5, 1/4}, {-1/5, 3/10, -1/10}, {1/10, -1/4, 1/5}};
targets = {{0, 7/20}, {17/10, 0}, {-1/2, 1}};   (* {distance, fraction} *)
adj = {{3/10, {1/2, -1/4, 1/5}}, {-1/5, {-3/10, 2/5, 1/10}}, {1/4, {1/5, 1/5, -2/5}}};  (* {t_bar, p_bar} *)
prec = 30;
floor = 3/10;
rho[{x_, y_, z_}] := 1 + (x^2 + y^2)/8 + z^2/4 + x y/10;
basisSpan[k_] := Table[Simplify[PiecewiseExpand[BSplineBasis[{3, knots}, i - 1, u]], k < u < k + 1], {i, 6}];
B = Table[basisSpan[k], {k, 0, 2}];
spanOf[t_] := Min[Floor[t], 2];
Cs[k_, P_] := B[[k + 1]] . P;
units = Flatten[Table[ReplacePart[ConstantArray[0, {6, 3}], {k, c} -> 1], {k, 6}, {c, 3}], 1];
at[expr_, t0_] := expr /. u -> t0;
integ[f_, lo_, hi_] := NIntegrate[f, {u, lo, hi}, WorkingPrecision -> prec, PrecisionGoal -> 24, AccuracyGoal -> 26, MaxRecursion -> 20];
upto[g_, t_?NumericQ] := Total[Table[integ[g[k], k, Min[k + 1, t]], {k, 0, spanOf[t]}]];
fmt[v_] := Module[{m, e}, {m, e} = MantissaExponent[N[v, 20]]; If[v == 0, "0.0", ToString[NumberForm[N[m, 18], 17]] <> "e" <> ToString[e]]];
row[name_, l_] := Print["static double const " <> name <> "[] = { " <> StringRiffle[fmt /@ Flatten[{l}], ", "] <> " };"];
Print["/* Generated by tests/reference/58_arc_length.wls (Mathematica, 30 digits). */"];

run[tag_, measure_] := Module[{mP, m0, Ltot, sol, derivs, fw, grad, hvp, uptoM},
  (* m on span k for control points P *)
  mP[k_, P_] := Module[{c = Cs[k, P], c1, c2, s}, c1 = D[c, u]; c2 = D[c1, u]; s = Sqrt[c1 . c1];
    Switch[measure, "arc", s,
      "curvature", Sqrt[floor^2 s^2 + Cross[c1, c2] . Cross[c1, c2] / s^4],
      "density", rho[c] s]];
  m0[k_] := mP[k, P0];
  uptoM[t_?NumericQ] := upto[m0, t];
  Ltot = upto[m0, 3];
  sol = Table[Module[{sig = targets[[i, 1]] + targets[[i, 2]] Ltot},
    t /. FindRoot[uptoM[t] == sig, {t, 3 sig / Ltot}, WorkingPrecision -> prec, AccuracyGoal -> 28, PrecisionGoal -> 28]], {i, 3}];
  derivs[i_, a_, b_] := Module[{t0 = sol[[i]], f = targets[[i, 2]], k, ma, mb, mab, Fa, Fb, Fab, Ft, Ftt, Fat, Fbt, ta, tb, tab,
      Ct, Ctt, Ca, Cat, Cbt, pa, pab},
    k = spanOf[t0];
    ma[kk_] := D[mP[kk, P0 + e1 a + e2 b], e1] /. {e1 -> 0, e2 -> 0};
    mb[kk_] := D[mP[kk, P0 + e1 a + e2 b], e2] /. {e1 -> 0, e2 -> 0};
    mab[kk_] := D[mP[kk, P0 + e1 a + e2 b], e1, e2] /. {e1 -> 0, e2 -> 0};
    Fa = upto[ma, t0] - f upto[ma, 3];
    Fb = upto[mb, t0] - f upto[mb, 3];
    Fab = upto[mab, t0] - f upto[mab, 3];
    Ft = at[m0[k], t0];
    Ftt = at[D[m0[k], u], t0];
    Fat = at[ma[k], t0]; Fbt = at[mb[k], t0];
    ta = -Fa / Ft; tb = -Fb / Ft;
    tab = -(Fab + Fat tb + Fbt ta + Ftt ta tb) / Ft;
    Ct = at[D[Cs[k, P0], u], t0];
    Ctt = at[D[Cs[k, P0], u, u], t0];
    Ca = at[Cs[k, a], t0];
    Cat = at[D[Cs[k, a], u], t0]; Cbt = at[D[Cs[k, b], u], t0];
    pa = Ca + Ct ta;
    pab = Cat tb + Cbt ta + Ctt ta tb + Ct tab;
    {ta, pa, tab, pab}];
  row["ref_total_" <> tag, Ltot];
  row["ref_t_" <> tag, sol];
  row["ref_p_" <> tag, Table[at[Cs[spanOf[sol[[i]]], P0], sol[[i]]], {i, 3}]];
  fw = Table[derivs[i, V, V], {i, 3}];
  row["ref_t1_" <> tag, fw[[All, 1]]]; row["ref_p1_" <> tag, fw[[All, 2]]];
  row["ref_t2_" <> tag, fw[[All, 3]]]; row["ref_p2_" <> tag, fw[[All, 4]]];
  grad = Table[Sum[Module[{d = derivs[i, units[[j]], units[[j]]]}, adj[[i, 1]] d[[1]] + adj[[i, 2]] . d[[2]]], {i, 3}], {j, 18}];
  row["ref_grad_" <> tag, grad];
  hvp = Table[Sum[Module[{d = derivs[i, V, units[[j]]]}, adj[[i, 1]] d[[3]] + adj[[i, 2]] . d[[4]]], {i, 3}], {j, 18}];
  row["ref_hvp_" <> tag, hvp];
];
run["arc", "arc"];
run["curv", "curvature"];
run["dens", "density"];
