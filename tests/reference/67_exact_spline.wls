(* Ground truth for tests/67_exact_spline.c: exact C^(k)(t), k = 0..3, of
   B-spline and NURBS curves with integer lattice control points, integer
   weights and integer knots in [0, 8] (repeated interior knots included,
   clamped and unclamped vectors), at t = T / 2^9.

   On span s (u_s <= t < u_(s+1), the last span at the domain end) the
   basis is the Cox-de Boor recursion with N_(i,0) = [i == s], so the curve
   is one polynomial / rational expression in t there; derivatives are
   symbolic. Each row gives the reduced fraction p/q of every component.
   Run: wolframscript -file 67_exact_spline.wls > 67_exact_spline.h *)
SeedRandom[6767];
shift = 9;
basis[knots_, s_, i_, 0, t_] := If[i == s, 1, 0];
basis[knots_, s_, i_, k_, t_] := Module[{a = knots[[i + k + 1]] - knots[[i + 1]], b = knots[[i + k + 2]] - knots[[i + 2]]},
	If[a == 0, 0, (t - knots[[i + 1]])/a basis[knots, s, i, k - 1, t]] +
	If[b == 0, 0, (knots[[i + k + 2]] - t)/b basis[knots, s, i + 1, k - 1, t]]];
curveOn[knots_, cp_, w_, p_, s_, t_] := Module[{n = Length[cp]},
	Sum[basis[knots, s, i, p, t] w[[i + 1]] cp[[i + 1]], {i, 0, n - 1}]/Sum[basis[knots, s, i, p, t] w[[i + 1]], {i, 0, n - 1}]];
spanOf[knots_, p_, n_, t_] := Module[{s = p},
	While[s < n - 1 && !(t < knots[[s + 2]] && knots[[s + 2]] > knots[[s + 1]]) || (s < n - 1 && knots[[s + 2]] <= t), s++];
	(* skip empty spans: the span with knots[s] <= t < knots[s+1] *)
	s];
findSpan[knots_, p_, n_, t_] := Module[{s},
	s = Select[Range[p, n - 1], knots[[# + 1]] <= t < knots[[# + 2]] &];
	If[s === {}, Max[Select[Range[p, n - 1], knots[[# + 1]] < knots[[# + 2]] &]], First[s]]];
mkKnots[p_, n_, clamped_] := Module[{inner, all},
	If[clamped == 1,
		inner = Sort[RandomInteger[{1, 7}, n - p - 1]];
		(* allow interior multiplicities up to p *)
		inner = Flatten[Take[#, UpTo[p]] & /@ Split[inner]];
		While[Length[inner] < n - p - 1, inner = Sort[Append[inner, RandomInteger[{1, 7}]]]; inner = Flatten[Take[#, UpTo[p]] & /@ Split[inner]]];
		Join[ConstantArray[0, p + 1], inner, ConstantArray[8, p + 1]],
		Sort[RandomInteger[{0, 8}, n + p + 1]] /. {} -> {}]];
cases = Flatten[Table[
	Module[{n = p + 1 + RandomInteger[{1, 4}], knots, cp, w, ts, dom},
		knots = mkKnots[p, n, clamped];
		(* unclamped vectors: strictly increasing to keep the domain non-empty *)
		If[clamped == 0, knots = Round[2^shift 8 Range[0, n + p]/(n + p)]/2^shift];
		cp = RandomInteger[{-2^20, 2^20}, {n, dim}];
		w = If[rat == 1, RandomInteger[{1, 1000}, n], ConstantArray[1, n]];
		dom = {knots[[p + 1]], knots[[n + 1]]};
		ts = Union[Join[{dom[[1]], dom[[2]]}, Select[knots, dom[[1]] < # < dom[[2]] &], Table[RandomInteger[Round[2^shift dom]]/2^shift, {3}]]];
		ts = Select[ts, IntegerQ[# 2^shift] &];
		{dim, p, rat, knots, cp, w, ts}],
	{dim, {2, 3}}, {p, {1, 2, 3, 4, 5, 7}}, {rat, {0, 1}}, {clamped, {1, 0}}], 3];
str[x_] := "\"" <> ToString[x] <> "\"";
Print["/* Generated by 67_exact_spline.wls; do not edit. */"];
Print["typedef struct ref_exact_spline { int dim, degree, rational, n, nk; long long cp[16 * 3]; long long w[16]; long long knots[32]; int knot_den; long long T; int k; char const* num[3]; char const* den[3]; } ref_exact_spline;"];
Print["static ref_exact_spline const g_ref_exact_spline[] = {"];
Do[
	Module[{dim = cs[[1]], p = cs[[2]], rat = cs[[3]], knots = cs[[4]], cp = cs[[5]], w = cs[[6]], n, kd, t, s, ders, cache = <||>},
		n = Length[cp];
		kd = LCM @@ Denominator /@ knots;
		Do[
			s = findSpan[knots, p, n, tt];
			If[!KeyExistsQ[cache, s],
				Module[{nb, C},
					(* memoized Cox-de Boor on span s *)
					Clear[nb];
					nb[i_, 0] := If[i == s, 1, 0];
					nb[i_, k_] := nb[i, k] = Module[{a = knots[[i + k + 1]] - knots[[i + 1]], b = knots[[i + k + 2]] - knots[[i + 2]]},
						Expand[If[a == 0, 0, (t - knots[[i + 1]])/a nb[i, k - 1]] + If[b == 0, 0, (knots[[i + k + 2]] - t)/b nb[i + 1, k - 1]]]];
					C = Sum[nb[i, p] w[[i + 1]] cp[[i + 1]], {i, 0, n - 1}]/Sum[nb[i, p] w[[i + 1]], {i, 0, n - 1}];
					cache[s] = Table[Together[D[C, {t, k}]], {k, 0, 3}]]];
			ders = cache[s];
			Do[
				Module[{vals = ders[[k + 1]] /. t -> tt},
					Print["\t{ ", dim, ", ", p, ", ", rat, ", ", n, ", ", Length[knots], ", { ", StringRiffle[ToString /@ Flatten[cp], ", "], " }, { ",
						StringRiffle[ToString /@ w, ", "], " }, { ", StringRiffle[ToString /@ (knots kd), ", "], " }, ", kd, ", ", tt 2^shift, ", ", k,
						", { ", StringRiffle[str[Numerator[#]] & /@ vals, ", "], If[dim == 2, ", \"0\"", ""], " }, { ",
						StringRiffle[str[Denominator[#]] & /@ vals, ", "], If[dim == 2, ", \"1\"", ""], " } },"]],
				{k, 0, 3}],
			{tt, cs[[7]]}]],
	{cs, cases}];
Print["};"];
