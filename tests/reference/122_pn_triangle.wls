#!/usr/bin/env wolframscript
(* Test 122's ground truth: a curved PN triangle (Vlachos, Peters, Boyd,
   Mitchell 2001) from the paper's definitions: the cubic control net (the
   edge points from the chord and the corner normals, the centre from the
   edge points), the quadratic normal field (mid-edge normals reflected
   across the edge's mid-plane) as a quadratic Bezier (the paper writes its
   mixed terms without the factor 2),
   exactly. At a few points (a, b) = (b1, b2): the position and its first and
   second derivatives, the unit normal field and its derivatives, and the
   principal curvatures from the normal field (the shape operator with
   L = Na.Xa, M = (Na.Xb + Nb.Xa)/2, N = Nb.Xb). Writes 122_pn_triangle.h. *)

P0 = {0, 0, 0}; P1 = {1, 1/10, 1/5}; P2 = {3/10, 9/10, -1/10};
nrm[v_] := v/Sqrt[v.v];
N0 = nrm[{-1/5, 1/10, 1}]; N1 = nrm[{3/10, -1/5, 1}]; N2 = nrm[{1/10, 2/5, 1}];
w[i_, j_, Pi_, Pj_, Ni_] := (Pj - Pi).Ni;
b300 = P0; b030 = P1; b003 = P2;
b210 = (2 P0 + P1 - w[0, 1, P0, P1, N0] N0)/3;
b120 = (2 P1 + P0 - w[1, 0, P1, P0, N1] N1)/3;
b021 = (2 P1 + P2 - w[1, 2, P1, P2, N1] N1)/3;
b012 = (2 P2 + P1 - w[2, 1, P2, P1, N2] N2)/3;
b102 = (2 P2 + P0 - w[2, 0, P2, P0, N2] N2)/3;
b201 = (2 P0 + P2 - w[0, 2, P0, P2, N0] N0)/3;
EE = (b210 + b120 + b021 + b012 + b102 + b201)/6; VV = (P0 + P1 + P2)/3;
b111 = EE + (EE - VV)/2;
S[a_, b_] := With[{c = 1 - a - b},
   b300 c^3 + b030 a^3 + b003 b^3 + 3 b210 c^2 a + 3 b120 c a^2 + 3 b021 a^2 b + 3 b012 a b^2 + 3 b102 c b^2 + 3 b201 c^2 b + 6 b111 c a b];
v[Pi_, Pj_, Ni_, Nj_] := 2 (Pj - Pi).(Ni + Nj)/((Pj - Pi).(Pj - Pi));
n110 = nrm[N0 + N1 - v[P0, P1, N0, N1] (P1 - P0)];
n011 = nrm[N1 + N2 - v[P1, P2, N1, N2] (P2 - P1)];
n101 = nrm[N2 + N0 - v[P2, P0, N2, N0] (P0 - P2)];
nq[a_, b_] := With[{c = 1 - a - b}, N0 c^2 + N1 a^2 + N2 b^2 + 2 n110 c a + 2 n011 a b + 2 n101 c b];
nf[a_, b_] := nrm[nq[a, b]];

pts = {{1/3, 1/3}, {1/10, 7/10}, {3/5, 1/5}, {1/2, 0}, {0, 0}};
rows = Table[Module[{a0 = p[[1]], b0 = p[[2]], X, Xa, Xb, Xaa, Xab, Xbb, Nn, Na, Nb, E1, F1, G1, L1, M1, N1c, det, H, K, k1, k2},
    X = S[a, b] /. {a -> a0, b -> b0};
    Xa = D[S[a, b], a] /. {a -> a0, b -> b0}; Xb = D[S[a, b], b] /. {a -> a0, b -> b0};
    Xaa = D[S[a, b], a, a] /. {a -> a0, b -> b0}; Xab = D[S[a, b], a, b] /. {a -> a0, b -> b0}; Xbb = D[S[a, b], b, b] /. {a -> a0, b -> b0};
    Nn = nf[a, b] /. {a -> a0, b -> b0};
    Na = D[nf[a, b], a] /. {a -> a0, b -> b0}; Nb = D[nf[a, b], b] /. {a -> a0, b -> b0};
    E1 = Xa.Xa; F1 = Xa.Xb; G1 = Xb.Xb; L1 = Na.Xa; M1 = (Na.Xb + Nb.Xa)/2; N1c = Nb.Xb;
    det = E1 G1 - F1^2; H = (L1 G1 + N1c E1 - 2 M1 F1)/(2 det); K = (L1 N1c - M1^2)/det;
    k1 = H + Sqrt[Max[H^2 - K, 0]]; k2 = H - Sqrt[Max[H^2 - K, 0]];
    N[Join[X, Xa, Xb, Xaa, Xab, Xbb, Nn, Na, Nb, {k1, k2}], 30]], {p, pts}];

cs[x_] := ToString[CForm[N[x, 20]]];
arr[name_, v_] := "static double const " <> name <> "[" <> ToString[Length[Flatten[v]]] <> "] = { " <> StringRiffle[cs /@ Flatten[v], ", "] <> " };\n";
Export[FileNameJoin[{DirectoryName[$InputFileName], "122_pn_triangle.h"}],
  StringJoin["/* generated by 122_pn_triangle.wls: a PN triangle from the paper's definitions */\n\n",
   arr["g122_P", {P0, P1, P2}], arr["g122_N", N[{N0, N1, N2}, 30]], arr["g122_pts", pts],
   "/* per point: X, Xa, Xb, Xaa, Xab, Xbb, N, Na, Nb (3 each), k1, k2 */\n",
   arr["g122_rows", rows]], "Text"];
Print["done"];
