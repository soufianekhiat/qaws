(* Ground truth for tests/68_exact_families.c: exact C^(k)(t), k = 0..3, of
   Hermite, uniform Catmull-Rom (open and closed) and polynomial curves.

   family 0: cubic Hermite, span i on [i, i + 1], points P and tangents M
             (lattice integers; the C test feeds i 2^-10 world units)
   family 1: uniform Catmull-Rom, open: span s on [s, s + 1] uses P_s..P_s+3
   family 2: uniform Catmull-Rom, closed: span s uses P_s-1..P_s+2 (mod n)
   family 3: polynomial sum a_k t^k on [t0, t1], a_k = cf_k 2^-12 world
             units, t0 = t0n / 16, t1 = t1n / 16

   t = T / 64; the last span holds the domain end. Values are in lattice
   units (world times 2^10), as reduced fractions p/q per component.
   Run: wolframscript -file 68_exact_families.wls > 68_exact_families.h *)
SeedRandom[6868];
herm[p0_, m0_, p1_, m1_, s_] := (2 s^3 - 3 s^2 + 1) p0 + (s^3 - 2 s^2 + s) m0 + (-2 s^3 + 3 s^2) p1 + (s^3 - s^2) m1;
cr[p0_, p1_, p2_, p3_, u_] := (2 p1 + (p2 - p0) u + (2 p0 - 5 p1 + 4 p2 - p3) u^2 + (-p0 + 3 p1 - 3 p2 + p3) u^3)/2;
spanOf[t_, count_] := Min[Floor[t], count - 1];
(* the curve as a function of t on span s *)
piece[0, P_, M_, s_, t_] := herm[P[[s + 1]], M[[s + 1]], P[[s + 2]], M[[s + 2]], t - s];
piece[1, P_, M_, s_, t_] := cr[P[[s + 1]], P[[s + 2]], P[[s + 3]], P[[s + 4]], t - s];
piece[2, P_, M_, s_, t_] := Module[{n = Length[P]}, cr[P[[Mod[s - 1, n] + 1]], P[[Mod[s, n] + 1]], P[[Mod[s + 1, n] + 1]], P[[Mod[s + 2, n] + 1]], t - s]];
spans[0, n_] := n - 1; spans[1, n_] := n - 3; spans[2, n_] := n;
str[x_] := "\"" <> ToString[x] <> "\"";
emit[fam_, dim_, n_, P_, M_, cf_, t0n_, t1n_, T_, k_, vals_] := Print["\t{ ", fam, ", ", dim, ", ", n, ", { ",
	StringRiffle[ToString /@ Flatten[P], ", "], " }, { ", StringRiffle[ToString /@ Flatten[M], ", "], " }, { ",
	StringRiffle[ToString /@ Flatten[cf], ", "], " }, ", t0n, ", ", t1n, ", ", T, ", ", k, ", { ",
	StringRiffle[str[Numerator[#]] & /@ vals, ", "], If[dim == 2, ", \"0\"", ""], " }, { ",
	StringRiffle[str[Denominator[#]] & /@ vals, ", "], If[dim == 2, ", \"1\"", ""], " } },"];
Print["/* Generated by 68_exact_families.wls; do not edit. */"];
Print["typedef struct ref_exact_family { int family, dim, n; long long p[8 * 3]; long long m[8 * 3]; long long cf[9 * 3]; long long t0n, t1n; long long T; int k; char const* num[3]; char const* den[3]; } ref_exact_family;"];
Print["static ref_exact_family const g_ref_exact_family[] = {"];
(* spline families *)
Do[
	Module[{P = RandomInteger[{-2^20, 2^20}, {n, dim}], M = If[fam == 0, RandomInteger[{-2^20, 2^20}, {n, dim}], {0}], cnt, Ts, t},
		cnt = spans[fam, n];
		Ts = Union[{0, 64 cnt, 64, 64 Floor[cnt/2]}, RandomInteger[{1, 64 cnt - 1}, 4]];
		Do[
			Module[{s = spanOf[T/64, cnt], C},
				C = piece[fam, P, M, s, t];
				Do[emit[fam, dim, n, P, M, {0}, 0, 0, T, k, D[C, {t, k}] /. t -> T/64], {k, 0, 3}]],
			{T, Ts}]],
	{fam, {0, 1, 2}}, {dim, {2, 3}}, {n, Switch[fam, 0, {2, 3, 6}, 1, {4, 5, 8}, 2, {3, 5, 8}]}];
(* polynomials *)
Do[
	Module[{cf = RandomInteger[{-2^20, 2^20}, {d + 1, dim}], t0n, t1n, Ts, t, C},
		{t0n, t1n} = dom;
		C = Sum[cf[[j + 1]] 2^-12 t^j, {j, 0, d}] 2^10;
		Ts = Union[{4 t0n, 4 t1n}, RandomInteger[{4 t0n + 1, 4 t1n - 1}, 4]];
		Do[Do[emit[3, dim, d + 1, {0}, {0}, cf, t0n, t1n, T, k, D[C, {t, k}] /. t -> T/64], {k, 0, 3}], {T, Ts}]],
	{dim, {2, 3}}, {d, {1, 2, 3, 5, 8}}, {dom, {{0, 16}, {-12, 40}, {8, 48}}}];
Print["};"];
