(* Ground truth for tests/90_offset_curves.c: the cusps of the offsets
   O = C + delta n (n the right normal of travel) of two Bezier curves, at 30
   digits. The offset has a cusp where g = 1 + delta k = 0, k the signed
   curvature (positive turning left). Squared, delta^2 (x'y'' - y'x'')^2 =
   (x'^2 + y'^2)^3 is a polynomial in t; its real roots in [0, 1] with
   delta k < 0 are the cusps. The cusp point is C + delta n there, which is
   also the centre of curvature (the evolute).
   Run: wolframscript -file 90_offset_curves.wls > 90_offset_curves.h *)
prec = 30;
fmt[v_] := Module[{m, e}, {m, e} = MantissaExponent[N[v, 20]]; If[v == 0, "0.0", ToString[NumberForm[N[m, 18], 17]] <> "e" <> ToString[e]]];
row[name_, l_] := Print["static double const " <> name <> "[] = { " <> StringRiffle[fmt /@ Flatten[{l}], ", "] <> " };"];
bez[P_, t_] := Sum[Binomial[Length[P] - 1, i] t^i (1 - t)^(Length[P] - 1 - i) P[[i + 1]], {i, 0, Length[P] - 1}];
cusps[P_, delta_] := Module[{c, c1, c2, cr, sp, roots, k},
  c = bez[P, t]; c1 = D[c, t]; c2 = D[c1, t];
  cr = c1[[1]] c2[[2]] - c1[[2]] c2[[1]]; sp = c1 . c1;
  roots = Map[t /. # &, NSolve[delta^2 cr^2 == sp^3 && 0 <= t <= 1, t, Reals, WorkingPrecision -> prec]];
  k[s_] := (cr / sp^(3/2)) /. t -> s;
  roots = Sort[Select[roots, delta k[#] < 0 &]];
  {roots, Flatten[Table[Module[{p = c /. t -> r, d = c1 /. t -> r, n}, n = {d[[2]], -d[[1]]} / Sqrt[d . d]; p + delta n], {r, roots}]]}];
Print["/* Generated by tests/reference/90_offset_curves.wls (Mathematica, 30 digits). */"];
(* the parabola y = x^2, x = 2t - 1, offset 1 to the left (toward its focus) *)
par = {{-1, 1}, {0, -1}, {1, 1}};
{r, p} = cusps[par, -1];
row["ref_parabola_t", r];
row["ref_parabola_p", p];
(* its evolute at the vertex: the centre of curvature (0, 1/2) *)
row["ref_parabola_evolute_vertex", {0, 1/2}];
(* a cubic S (curvature peaks 2.395, radius 0.42), offset 0.6 to the right and to the left *)
s = {{0, 0}, {1, 2}, {2, -2}, {3, 0}};
{r, p} = cusps[s, 3/5];
row["ref_s_right_t", r];
row["ref_s_right_p", p];
{r, p} = cusps[s, -3/5];
row["ref_s_left_t", r];
row["ref_s_left_p", p];
