(* Ground truth for tests/56_diff_functionals.c: integral functionals of a
   cubic B-spline curve (length, bending, curvature squared) and of a bicubic
   B-spline surface (area, thin plate, Willmore), with their tangent,
   second tangent, gradient and Hessian-vector product with respect to the
   control points.

   Curves: along P0 + e1 a + e2 b the integrand of each span is
   differentiated symbolically in e1, e2 and integrated with NIntegrate at
   30 digits:
     length            |C'|
     bending           |C''|^2
     curvature squared |C' x C''|^2 / |C'|^5   (kappa^2 ds)
   tangent = d/de, tangent2 = d2/de2 along V; gradient entry j = d/de along
   the unit e_j; HVP entry j = d2/(de1 de2) along V and e_j.

   Surfaces: the integrand is a function f(y) of the jet y = (Su, Sv, Suu,
   Suv, Svv), differentiated symbolically in y:
     area       |Su x Sv|
     thin plate |Suu|^2 + 2 |Suv|^2 + |Svv|^2
     Willmore   H^2 |Su x Sv|, H = (E N + G L - 2 F M) / (2 (E G - F^2))
   The jet is linear in the control points (y_k = sum B_k,ij P_ij with
   B_k,ij the matching derivative of N_i(u) N_j(v)), so the gradient
   entry of P_ij is sum_k B_k,ij df/dy_k and the HVP entry is
   sum_k B_k,ij (d2f/dy2 ydot)_k with ydot the jet of V. Each polynomial
   patch is integrated with a product Gauss-Legendre rule at 40 digits; the
   rule is run at two orders and the largest relative difference is printed
   as a comment (the integrands are analytic on every patch).
   Run: wolframscript -file 56_functionals.wls > 56_functionals.h *)
prec = 30;
fmt[v_] := Module[{m, e}, {m, e} = MantissaExponent[N[v, 20]]; If[v == 0, "0.0", ToString[NumberForm[N[m, 18], 17]] <> "e" <> ToString[e]]];
row[name_, l_] := Print["static double const " <> name <> "[] = { " <> StringRiffle[fmt /@ Flatten[{l}], ", "] <> " };"];
Print["/* Generated by tests/reference/56_functionals.wls (Mathematica, 30 digits). */"];

(* ---------------------------------------------------------------- curves *)
knots = {0, 0, 0, 0, 1, 2, 3, 3, 3, 3};
P0 = {{0, 0, 0}, {1, 2, 1/2}, {5/2, 2, -1/2}, {7/2, 1/2, 1}, {5, 1, 0}, {6, 3, 1/2}};
V = {{1/5, -3/10, 1/10}, {-1/4, 1/5, 3/10}, {1/10, 1/10, -1/5}, {3/10, -1/5, 1/4}, {-1/5, 3/10, -1/10}, {1/10, -1/4, 1/5}};
basisSpan[kn_, n_, k_] := Table[Simplify[PiecewiseExpand[BSplineBasis[{3, kn}, i - 1, u]], k < u < k + 1], {i, n}];
B = Table[basisSpan[knots, 6, k], {k, 0, 2}];
units = Flatten[Table[ReplacePart[ConstantArray[0, {6, 3}], {k, c} -> 1], {k, 6}, {c, 3}], 1];
integ[f_, lo_, hi_] := NIntegrate[f, {u, lo, hi}, WorkingPrecision -> prec, PrecisionGoal -> 24, AccuracyGoal -> 26, MaxRecursion -> 20];
curveF[name_, k_, P_] := Module[{c1 = D[B[[k + 1]] . P, u], c2},
  c2 = D[c1, u];
  Switch[name,
    "length", Sqrt[c1 . c1],
    "bending", c2 . c2,
    "curv2", Cross[c1, c2] . Cross[c1, c2] / (c1 . c1)^(5/2)]];
total[g_] := Sum[integ[g[k], k, k + 1], {k, 0, 2}];
runCurve[tag_, name_] := Module[{val, t1, t2, grad, hvp},
  val = total[curveF[name, #, P0] &];
  t1 = total[(D[curveF[name, #, P0 + e1 V], e1] /. e1 -> 0) &];
  t2 = total[(D[curveF[name, #, P0 + e1 V], {e1, 2}] /. e1 -> 0) &];
  grad = Table[total[(D[curveF[name, #, P0 + e1 units[[j]]], e1] /. e1 -> 0) &], {j, 18}];
  hvp = Table[total[(D[curveF[name, #, P0 + e1 V + e2 units[[j]]], e1, e2] /. {e1 -> 0, e2 -> 0}) &], {j, 18}];
  row["ref_curve_" <> tag, {val, t1, t2}];
  row["ref_curve_grad_" <> tag, grad];
  row["ref_curve_hvp_" <> tag, hvp]];
runCurve["length", "length"];
runCurve["bending", "bending"];
runCurve["curv2", "curv2"];

(* -------------------------------------------------------------- surfaces *)
sknots = {0, 0, 0, 0, 1, 2, 2, 2, 2};
SB = Table[basisSpan[sknots, 5, k], {k, 0, 1}];
SP = Flatten[Table[{i/2 + (Mod[2 i + 3 j, 5] - 2)/20, j/2 + (Mod[3 i + j, 5] - 2)/20, (Mod[3 i + 5 j, 7] - 3)/10},
  {i, 0, 4}, {j, 0, 4}], 1];
SV = Flatten[Table[(Mod[7 i + 3 j + 5 c, 11] - 5)/10, {i, 0, 4}, {j, 0, 4}, {c, 0, 2}], 1];
yv = Partition[Table[Symbol["y" <> ToString[k]], {k, 15}], 3];
ydv = Partition[Table[Symbol["yd" <> ToString[k]], {k, 15}], 3];
surfF[name_, j_] := Module[{su = j[[1]], sv = j[[2]], suu = j[[3]], suv = j[[4]], svv = j[[5]], n, nl, nn, ee, ff, gg, l, m, nq, h},
  n = Cross[su, sv]; nl = Sqrt[n . n];
  Switch[name,
    "area", nl,
    "plate", suu . suu + 2 suv . suv + svv . svv,
    "willmore", nn = n / nl; ee = su . su; ff = su . sv; gg = sv . sv;
      l = suu . nn; m = suv . nn; nq = svv . nn;
      h = (ee nq + gg l - 2 ff m) / (2 (ee gg - ff^2)); h^2 nl]];
(* value, tangent, tangent2, gradient in y (15), HVP in y (15) *)
surfFns[name_] := Module[{q = surfF[name, yv + s ydv], q1},
  q1 = D[q, s] /. s -> 0;
  Function[Evaluate[Join[Flatten[yv], Flatten[ydv]]], Evaluate[
    {surfF[name, yv], q1, D[q, {s, 2}] /. s -> 0, D[surfF[name, yv], {Flatten[yv]}], D[q1, {Flatten[yv]}]}]]];
(* basis derivatives (order a in u, b in v) on patch (ku, kv) at (uu, vv) *)
derivOrders = {{1, 0}, {0, 1}, {2, 0}, {1, 1}, {0, 2}};
runSurface[name_, n_] := Module[{fn = surfFns[name], gx, gw, gerr, acc = ConstantArray[0, 3 + 75 + 75], ku, kv, a, b},
  {gx, gw, gerr} = NIntegrate`GaussRuleData[n, 40];
  Do[
    Module[{nu, nv, vv},
      nu = Table[D[SB[[ku + 1]], {u, o}], {o, 0, 2}];
      nv = Table[D[SB[[kv + 1]] /. u -> vv, {vv, o}], {o, 0, 2}];
      Do[
        Module[{uu = ku + gx[[a]], v0 = kv + gx[[b]], w = gw[[a]] gw[[b]], nuv, nvv, Bk, jet, jetd, r, g, hv},
          nuv = nu /. u -> uu; nvv = nv /. vv -> v0;
          Bk = Table[Flatten[Outer[Times, nuv[[o[[1]] + 1]], nvv[[o[[2]] + 1]]]], {o, derivOrders}];
          jet = Bk . SP; jetd = Bk . SV;
          r = Apply[fn, Join[Flatten[jet], Flatten[jetd]]];
          g = Partition[r[[4]], 3]; hv = Partition[r[[5]], 3];
          acc += w Join[r[[1 ;; 3]], Flatten[Transpose[Bk] . g], Flatten[Transpose[Bk] . hv]]],
        {a, n}, {b, n}]],
    {ku, 0, 1}, {kv, 0, 1}];
  acc];
surfConv = 0;
runSurfaceRef[tag_, name_] := Module[{lo = runSurface[name, 24], hi = runSurface[name, 32]},
  surfConv = Max[surfConv, Max[Abs[hi - lo] / Map[Max[1, Abs[#]] &, hi]]];
  row["ref_surface_" <> tag, hi[[1 ;; 3]]];
  row["ref_surface_grad_" <> tag, hi[[4 ;; 78]]];
  row["ref_surface_hvp_" <> tag, hi[[79 ;; 153]]]];
runSurfaceRef["area", "area"];
runSurfaceRef["plate", "plate"];
runSurfaceRef["willmore", "willmore"];
Print["/* surface Gauss rule, 24 vs 32 points per patch direction: max relative difference " <> fmt[surfConv] <> " */"];
