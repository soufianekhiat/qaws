(* Ground truth for tests/74_exact_surface_hits.c: intersections of lines
   x = p0 + t (p1 - p0) with Bezier, B-spline and NURBS surfaces.

   Per knot rectangle the surface is one rational expression S(u, v);
   X_c(u, v) - (p0_c + t d_c) W(u, v) = 0 (c = x, y, z) is solved exactly
   with (u, v) in the rectangle. Hits are deduplicated (patch edges), sorted
   by t, and listed as 25-digit decimals (u, v, t) with a flag when u and v
   are both dyadic. Coordinates are lattice integers (2^-10 world units).
   Run: wolframscript -file 74_exact_surface_hits.wls > 74_exact_surface_hits.h *)
SeedRandom[7474];
dyadicQ[r0_] := Module[{r = RootReduce[r0]}, IntegerQ[r] || (Head[r] === Rational && Denominator[r] == 2^(IntegerLength[Denominator[r], 2] - 1))];
fmt[r_] := If[r == 0, "0", Module[{m, e}, {m, e} = MantissaExponent[N[r, 40]]; ToString[Round[m 10^25]] <> "e" <> ToString[e - 25]]];
basisOn[knots_, p_, n_, s_, t_] := Module[{nb},
	nb[i_, 0] := If[i == s, 1, 0];
	nb[i_, k_] := nb[i, k] = Module[{a = knots[[i + k + 1]] - knots[[i + 1]], b = knots[[i + k + 2]] - knots[[i + 2]]},
		Expand[If[a == 0, 0, (t - knots[[i + 1]])/a nb[i, k - 1]] + If[b == 0, 0, (knots[[i + k + 2]] - t)/b nb[i + 1, k - 1]]]];
	Table[nb[i, p], {i, 0, n - 1}]];
clamped[p_, n_] := Join[ConstantArray[0, p + 1], Range[1, n - p - 1], ConstantArray[n - p, p + 1]];
homPatch[ku_, kv_, p_, q_, cp_, w_, su_, sv_, u_, v_] := Module[{nu = Length[cp], nv = Length[cp[[1]]], Bu, Bv},
	Bu = basisOn[ku, p, nu, su, u];
	Bv = basisOn[kv, q, nv, sv, v];
	Append[Table[Expand[Sum[Bu[[i]] Bv[[j]] w[[i, j]] cp[[i, j, c]], {i, nu}, {j, nv}]], {c, 3}], Expand[Sum[Bu[[i]] Bv[[j]] w[[i, j]], {i, nu}, {j, nv}]]]];
hits[ku_, kv_, p_, q_, cp_, w_, p0_, p1_] := Module[{nu = Length[cp], nv = Length[cp[[1]]], res = {}, u, v, t, d = p1 - p0},
	Do[
		If[ku[[su + 1]] < ku[[su + 2]] && kv[[sv + 1]] < kv[[sv + 2]],
			Module[{H = homPatch[ku, kv, p, q, cp, w, su, sv, u, v], sols},
				sols = Solve[Join[Table[H[[c]] - (p0[[c]] + t d[[c]]) H[[4]] == 0, {c, 3}],
					{ku[[su + 1]] <= u <= ku[[su + 2]], kv[[sv + 1]] <= v <= kv[[sv + 2]]}], {u, v, t}, Reals];
				If[sols =!= {}, res = Join[res, RootReduce[{u, v, t} /. sols]]]]],
		{su, p, nu - 1}, {sv, q, nv - 1}];
	SortBy[DeleteDuplicates[res], N[#[[3]]] &]];
cases = {};
(* single Bezier patches: polynomial and rational *)
Do[
	Module[{cp = RandomInteger[{-2^17, 2^17}, {pq[[1]] + 1, pq[[2]] + 1, 3}], w, ku = clamped[pq[[1]], pq[[1]] + 1], kv = clamped[pq[[2]], pq[[2]] + 1], u0, v0, P, H, u, v},
		w = If[rat == 1, RandomInteger[{1, 20}, {pq[[1]] + 1, pq[[2]] + 1}], ConstantArray[1, {pq[[1]] + 1, pq[[2]] + 1}]];
		(* a line through a rounded surface point *)
		{u0, v0} = RandomInteger[{10, 90}, 2]/100;
		H = homPatch[ku, kv, pq[[1]], pq[[2]], cp, w, pq[[1]], pq[[2]], u, v] /. {u -> u0, v -> v0};
		P = Round[Most[H]/Last[H]];
		AppendTo[cases, {pq[[1]], pq[[2]], rat, cp, w, ku, kv, P, P + RandomInteger[{-2^16, 2^16}, 3]}];
		(* a random line through the box *)
		AppendTo[cases, {pq[[1]], pq[[2]], rat, cp, w, ku, kv, RandomInteger[{-2^17, 2^17}, 3], RandomInteger[{-2^17, 2^17}, 3]}]],
	{pq, {{1, 1}, {2, 2}, {2, 3}, {3, 3}}}, {rat, {0, 1}}];
(* polynomial patches through the exact point S(1/2, 1/2) *)
Do[
	Module[{cp = 64 RandomInteger[{-2^11, 2^11}, {pq[[1]] + 1, pq[[2]] + 1, 3}], w, ku = clamped[pq[[1]], pq[[1]] + 1], kv = clamped[pq[[2]], pq[[2]] + 1], H, P, u, v},
		w = ConstantArray[1, {pq[[1]] + 1, pq[[2]] + 1}];
		H = homPatch[ku, kv, pq[[1]], pq[[2]], cp, w, pq[[1]], pq[[2]], u, v] /. {u -> 1/2, v -> 1/2};
		P = Most[H]/Last[H];
		AppendTo[cases, {pq[[1]], pq[[2]], 0, cp, w, ku, kv, P, P + RandomInteger[{-2^16, 2^16}, 3]}]],
	{pq, {{2, 2}, {3, 3}}}];
(* B-spline and NURBS surfaces: 4 x 4 control points, biquadratic, 2 x 2 patches *)
Do[
	Module[{cp = RandomInteger[{-2^17, 2^17}, {4, 4, 3}], w = If[rat == 1, RandomInteger[{1, 20}, {4, 4}], ConstantArray[1, {4, 4}]], ku = clamped[2, 4], H, P, u, v},
		H = homPatch[ku, ku, 2, 2, cp, w, 2, 3, u, v] /. {u -> 3/10, v -> 17/10};
		P = Round[Most[H]/Last[H]];
		AppendTo[cases, {2, 2, rat, cp, w, ku, ku, P, P + RandomInteger[{-2^16, 2^16}, 3]}];
		AppendTo[cases, {2, 2, rat, cp, w, ku, ku, RandomInteger[{-2^17, 2^17}, 3], RandomInteger[{-2^17, 2^17}, 3]}]],
	{rat, {0, 1}}, {rep, 2}];
Print["/* Generated by 74_exact_surface_hits.wls; do not edit. */"];
Print["typedef struct ref_exact_surface_hits { int p, q, rational, nu, nv; long long cp[4 * 4 * 3]; long long w[16]; long long ku[8]; long long kv[8]; int nku, nkv; char const* p0[3]; char const* p1[3]; int n; char const* u[12]; char const* v[12]; char const* t[12]; int dy[12]; } ref_exact_surface_hits;"];
Print["static ref_exact_surface_hits const g_ref_exact_surface_hits[] = {"];
Do[
	Module[{p = cs[[1]], q = cs[[2]], rat = cs[[3]], cp = cs[[4]], w = cs[[5]], ku = cs[[6]], kv = cs[[7]], p0 = cs[[8]], p1 = cs[[9]], list, ex},
		list = hits[ku, kv, p, q, cp, w, p0, p1];
		ex[x_] := "\"" <> If[IntegerQ[x], ToString[x], ToString[Numerator[x]] <> "/" <> ToString[Denominator[x]]] <> "\"";
		Print["\t{ ", p, ", ", q, ", ", rat, ", ", Length[cp], ", ", Length[cp[[1]]], ", { ", StringRiffle[ToString /@ Flatten[cp], ", "], " }, { ",
			StringRiffle[ToString /@ Flatten[w], ", "], " }, { ", StringRiffle[ToString /@ ku, ", "], " }, { ", StringRiffle[ToString /@ kv, ", "], " }, ",
			Length[ku], ", ", Length[kv], ", { ", StringRiffle[ex /@ p0, ", "], " }, { ", StringRiffle[ex /@ p1, ", "], " }, ", Length[list], ", { ",
			If[list === {}, "0", StringRiffle["\"" <> fmt[#[[1]]] <> "\"" & /@ list, ", "]], " }, { ",
			If[list === {}, "0", StringRiffle["\"" <> fmt[#[[2]]] <> "\"" & /@ list, ", "]], " }, { ",
			If[list === {}, "0", StringRiffle["\"" <> fmt[#[[3]]] <> "\"" & /@ list, ", "]], " }, { ",
			If[list === {}, "0", StringRiffle[ToString[If[dyadicQ[#[[1]]] && dyadicQ[#[[2]]], 1, 0]] & /@ list, ", "]], " } },"]],
	{cs, cases}];
Print["};"];
