(* Ground truth for tests/63_exact_int.c: exact integer arithmetic on values
   up to about 1900 bits (Mathematica integers are exact).

   Rows of {a, b, a + b, a - b, a * b, sign(a - b) compare, a * 2^k,
   sign(a) floor(|a| / 2^k), k, nearest double of a as 40-digit text}. The
   product operands are kept below 1020 bits so a * b fits 2048 bits.
   Run: wolframscript -file 63_exact_int.wls > 63_exact_int.h *)
SeedRandom[6363];
big[bits_] := RandomChoice[{-1, 1}] RandomInteger[{0, 2^bits - 1}];
(* operand sizes: tiny, limb edges, mid, large *)
sizes = {1, 31, 32, 33, 63, 64, 65, 96, 127, 128, 200, 333, 511, 512, 700, 1019};
rows = Flatten[Table[
	Module[{a = big[sa], b = big[sb], k = RandomInteger[{0, 300}]},
		{a, b, k}],
	{sa, sizes}, {sb, sizes[[;; ;; 3]]}], 1];
(* carries across every limb: 2^n - 1 plus 1, and borrows *)
rows = Join[rows, Table[{2^n - 1, 1, 5}, {n, {31, 32, 64, 96, 1000}}], Table[{2^n, -1, 7}, {n, {32, 64, 1000}}],
	{{0, 0, 0}, {0, 5, 3}, {-5, 0, 2}, {123456789, -123456789, 1}}];
sh[a_, k_] := Sign[a] Floor[Abs[a]/2^k];
str[x_] := "\"" <> ToString[x] <> "\"";
dbl[x_] := "\"" <> StringReplace[ToString[N[x, 40], InputForm, NumberMarks -> False], "*^" -> "e"] <> "\"";
Print["/* Generated by 63_exact_int.wls; do not edit. */"];
Print["typedef struct ref_exact_int_row { char const *a, *b, *sum, *diff, *prod; int cmp; char const *shl, *shr; unsigned int k; char const* nearest; } ref_exact_int_row;"];
Print["static ref_exact_int_row const g_ref_exact_int[] = {"];
Do[
	Module[{a = r[[1]], b = r[[2]], k = r[[3]]},
		Print["\t{ ", str[a], ", ", str[b], ", ", str[a + b], ", ", str[a - b], ", ", str[a b], ", ", Sign[a - b], ", ",
			str[a 2^k], ", ", str[sh[a, k]], ", ", k, ", ", If[a == 0, "\"0\"", dbl[a]], " },"]],
	{r, rows}];
Print["};"];
