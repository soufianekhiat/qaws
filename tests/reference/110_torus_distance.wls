#!/usr/bin/env wolframscript
(* Test 110's torus: the geodesic distance between point pairs on the torus
   R = 1, r = 0.35, (u, v) -> ((R + r cos 2 pi v) cos 2 pi u, (R + r cos 2 pi v) sin 2 pi u, r sin 2 pi v)
   (qaws_surface_create_revolution of the circle of radius 0.35 about (1, 0)).
   The global shortest geodesic: shot from 360 first angles over a length up
   to 8, each trajectory's nearest approach to a copy of the target refined
   by FindRoot on (angle, length), the shortest landing kept.
   Writes 110_torus_distance.h. *)

R = 1; r = 35/100;
eqs[al_, p0_, t0_] := {
  ph''[s] == 2 r Sin[th[s]]/(R + r Cos[th[s]]) ph'[s] th'[s],
  th''[s] == -(R + r Cos[th[s]]) Sin[th[s]]/r ph'[s]^2,
  ph[0] == p0, th[0] == t0,
  ph'[0] == Cos[al]/(R + r Cos[t0]), th'[0] == Sin[al]/r};

shoot[al_?NumericQ, p0_, t0_, len_] := Module[{sol},
  sol = NDSolve[eqs[al, p0, t0], {ph, th}, {s, 0, len}, WorkingPrecision -> 30,
    PrecisionGoal -> 20, AccuracyGoal -> 20, MaxSteps -> Infinity];
  {ph, th} /. First[sol]];

(* the end of the geodesic (a, l), remembered: FindRoot asks for each coordinate *)
endf[a_?NumericQ, l_?NumericQ, p0_, t0_] := endf[a, l, p0, t0] = Module[{f = shoot[a, p0, t0, l]}, {f[[1]][l], f[[2]][l]}];
end1[a_?NumericQ, l_?NumericQ, p0_, t0_] := endf[a, l, p0, t0][[1]];
end2[a_?NumericQ, l_?NumericQ, p0_, t0_] := endf[a, l, p0, t0][[2]];

(* the nearest copy (2 pi k, 2 pi m) of the target to a point *)
near[{x_, y_}, {tx_, ty_}] := {tx + 2 Pi Round[(x - tx)/(2 Pi)], ty + 2 Pi Round[(y - ty)/(2 Pi)]};

dist[{u0_, v0_}, {u1_, v1_}] := Module[{p0 = 2 Pi u0, t0 = 2 Pi v0, tgt = {2 Pi u1, 2 Pi v1}, best = Infinity, cands = {}},
  Do[
   Module[{f = shoot[al, p0, t0, 8], ss, d, smin, c},
    ss = Range[0, 8, 1/50];
    d = Table[With[{q = {f[[1]][x], f[[2]][x]}}, Norm[q - near[q, tgt]]], {x, ss}];
    smin = ss[[First[Ordering[d, 1]]]];
    If[Min[d] < 0.3, AppendTo[cands, {al, smin, near[{f[[1]][smin], f[[2]][smin]}, tgt]}]]],
   {al, 0, 2 Pi - 2 Pi/360, 2 Pi/360}];
  Do[
   Module[{al0 = c[[1]], l0 = c[[2]], tg = c[[3]], fr},
    fr = Quiet[FindRoot[
        {end1[a, l, p0, t0] - tg[[1]], end2[a, l, p0, t0] - tg[[2]]},
        {{a, al0}, {l, Max[l0, 10^-3]}}, WorkingPrecision -> 30, AccuracyGoal -> 18, PrecisionGoal -> 18]];
    (* kept when it lands: FindRoot's messages (precision, steps) are no verdict *)
    If[(l /. fr) > 0 && Norm[{end1[a, l, p0, t0] - tg[[1]], end2[a, l, p0, t0] - tg[[2]]} /. fr] < 10^-15, best = Min[best, l /. fr]]],
   {c, cands}];
  best];

pairs = {{{2/10, 0}, {8/10, 0}}, {{2/10, 0}, {8/10, 5/100}}, {{1/10, 3/10}, {6/10, 7/10}}, {{5/100, 5/10}, {55/100, 5/10}}};
vals = Table[dist @@ pq, {pq, pairs}];
Print[vals];
Export[FileNameJoin[{DirectoryName[$InputFileName], "110_torus_distance.h"}],
  StringJoin[
   "/* generated by 110_torus_distance.wls: global geodesic distances on the torus R = 1, r = 0.35 */\n",
   "static double const g110_torus_pairs[4][4] = {\n",
   StringRiffle[Table["\t{ " <> StringRiffle[ToString[CForm[N[#]]] & /@ Flatten[pq], ", "] <> " }", {pq, pairs}], ",\n"], "\n};\n",
   "static double const g110_torus_distance[4] = { ",
   StringRiffle[ToString[CForm[N[#, 17]]] & /@ vals, ", "], " };\n"], "Text"];
