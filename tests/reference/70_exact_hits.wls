(* Ground truth for tests/70_exact_hits.c: intersections of Bezier and
   rational Bezier curves with lines (2D) and planes (3D).

   f(t) = numerator of N . (C(t) - P) with N = perp(p1 - p0) in 2D (line
   through p0, p1) or the plane normal in 3D. Every root of f in [0, 1] is
   listed (decimal, 25 digits) with its multiplicity and whether it is a
   dyadic rational (then the kernel must return it as an exact point).
   expect: 0 hits, 1 certification failure (a non-dyadic multiple root),
   2 overlap (f == 0). Coordinates are lattice integers (2^-10 world units);
   the plane normal is a small integer vector.
   Run: wolframscript -file 70_exact_hits.wls > 70_exact_hits.h *)
SeedRandom[7070];
bern[n_, i_, t_] := Binomial[n, i] t^i (1 - t)^(n - i);
curve[cp_, w_, t_] := Module[{n = Length[cp] - 1}, Sum[bern[n, i, t] w[[i + 1]] cp[[i + 1]], {i, 0, n}]/Sum[bern[n, i, t] w[[i + 1]], {i, 0, n}]];
dyadicQ[r_] := Element[r, Rationals] && (Denominator[r] == 2^IntegerLength[Denominator[r], 2] / 2 || Denominator[r] == 1);
fmt[r_] := If[r == 0, "0", Module[{m, e}, {m, e} = MantissaExponent[N[r, 40]]; ToString[Round[m 10^25]] <> "e" <> ToString[e - 25]]];
rnd2[v_] := Round[v];
cases = {};
(* 2D random curves and lines *)
Do[
	Module[{cp = RandomInteger[{-2^19, 2^19}, {d + 1, 2}], w = If[rat == 1, RandomInteger[{1, 50}, d + 1], ConstantArray[1, d + 1]], t, C, p0, p1},
		C = curve[cp, w, t];
		(* through two rounded curve points: at least two crossings, usually more *)
		p0 = rnd2[C /. t -> RandomInteger[{5, 45}]/100];
		p1 = rnd2[C /. t -> RandomInteger[{55, 95}]/100];
		AppendTo[cases, {2, d, rat, cp, w, Append[p0, 0], Append[p1, 0]}];
		(* random line through the bounding box *)
		AppendTo[cases, {2, d, rat, cp, w, Append[RandomInteger[{-2^19, 2^19}, 2], 0], Append[RandomInteger[{-2^19, 2^19}, 2], 0]}];
		(* polynomial curves: a line through the exact point C(1/2) (and C(3/8)) *)
		If[rat == 0,
			p0 = C /. t -> 1/2; p1 = C /. t -> 3/8;
			If[IntegerQ[p0[[1]]] && IntegerQ[p0[[2]]] && IntegerQ[p1[[1]]] && IntegerQ[p1[[2]]] && p0 != p1,
				AppendTo[cases, {2, d, rat, cp, w, Append[p0, 0], Append[p1, 0]}]]]],
	{d, {2, 3, 4, 6, 8}}, {rat, {0, 1}}];
(* control points on multiples of 2^12 so C(1/2), C(3/8) are lattice points *)
Do[
	Module[{cp = 4096 RandomInteger[{-2^8, 2^8}, {d + 1, 2}], w = ConstantArray[1, d + 1], t, C, p0, p1},
		C = curve[cp, w, t];
		p0 = C /. t -> 1/2; p1 = C /. t -> 3/8;
		AppendTo[cases, {2, d, 0, cp, w, Append[p0, 0], Append[p1, 0]}];
		(* a tangent at the dyadic t = 1/2 *)
		p1 = p0 + (D[C, t] /. t -> 1/2)/2^4;
		If[IntegerQ[p1[[1]]] && IntegerQ[p1[[2]]], AppendTo[cases, {2, d, 0, cp, w, Append[p0, 0], Append[p1, 0]}]]],
	{d, {2, 3, 4}}];
(* a tangency at the non-dyadic t = 2/3: y = 2 y1 t (1 - t) + y2 t^2, y1 = 2 m, y2 = m, top 4 m / 3 *)
AppendTo[cases, {2, 2, 0, {{-3000, 0}, {0, 6 * 3000}, {4000, 3 * 3000}}, {1, 1, 1}, {0, 4 * 3000, 0}, {1000, 4 * 3000, 0}}];
(* collinear control points: overlap *)
AppendTo[cases, {2, 3, 1, {{0, 0}, {300, 600}, {700, 1400}, {1000, 2000}}, {1, 3, 2, 1}, {-100, -200, 0}, {2000, 4000, 0}}];
(* 3D curves and planes *)
Do[
	Module[{cp = RandomInteger[{-2^19, 2^19}, {d + 1, 3}], w = If[rat == 1, RandomInteger[{1, 50}, d + 1], ConstantArray[1, d + 1]], t, C, pt},
		C = curve[cp, w, t];
		pt = Round[C /. t -> RandomInteger[{20, 80}]/100];
		AppendTo[cases, {3, d, rat, cp, w, pt, RandomInteger[{-9, 9}, 3]}];
		AppendTo[cases, {3, d, rat, cp, w, RandomInteger[{-2^18, 2^18}, 3], RandomInteger[{-9, 9}, 3]}]],
	{d, {2, 3, 5, 7}}, {rat, {0, 1}}];
Print["/* Generated by 70_exact_hits.wls; do not edit. */"];
Print["typedef struct ref_exact_hits { int dim, degree, rational; long long cp[9 * 3]; long long w[9]; long long a[3]; long long b[3]; int expect, nroots; char const* root[16]; int mult[16]; int dyadic[16]; } ref_exact_hits;"];
Print["static ref_exact_hits const g_ref_exact_hits[] = {"];
Do[
	Module[{dim = cs[[1]], d = cs[[2]], rat = cs[[3]], cp = cs[[4]], w = cs[[5]], a = cs[[6]], b = cs[[7]], t, C, f, roots, mults, dys, expect, nrm},
		C = curve[cp, w, t];
		f = If[dim == 2,
			Module[{dir = b[[1 ;; 2]] - a[[1 ;; 2]]}, dir[[1]] (C[[2]] - a[[2]]) - dir[[2]] (C[[1]] - a[[1]])],
			b . (C - a)];
		f = Numerator[Together[f]];
		If[PossibleZeroQ[Expand[f]],
			expect = 2; roots = {}; mults = {}; dys = {},
			roots = Module[{sol = Solve[f == 0 && 0 <= t <= 1, t, Reals]}, If[sol === {}, {}, SortBy[DeleteDuplicates[t /. sol], N]]];
			mults = Table[Module[{m = 1}, While[RootReduce[D[f, {t, m}] /. t -> r] == 0, m++]; m], {r, roots}];
			dys = Table[If[dyadicQ[r], 1, 0], {r, roots}];
			expect = If[Or @@ Table[mults[[k]] > 1 && dys[[k]] == 0, {k, Length[roots]}], 1, 0]];
		Print["\t{ ", dim, ", ", d, ", ", rat, ", { ", StringRiffle[ToString /@ Flatten[cp], ", "], " }, { ", StringRiffle[ToString /@ w, ", "],
			" }, { ", StringRiffle[ToString /@ a, ", "], " }, { ", StringRiffle[ToString /@ b, ", "], " }, ", expect, ", ", Length[roots], ", { ",
			If[roots === {}, "0", StringRiffle["\"" <> fmt[#] <> "\"" & /@ roots, ", "]], " }, { ",
			If[roots === {}, "0", StringRiffle[ToString /@ mults, ", "]], " }, { ",
			If[roots === {}, "0", StringRiffle[ToString /@ dys, ", "]], " } },"]],
	{cs, cases}];
Print["};"];
