(* Ground truth for tests/64_exact_predicates.c: exact signs of orient2d,
   orient3d and ratio comparisons on double inputs.

   Every double is emitted as {m, e} with value m 2^e exactly (|m| < 2^53),
   so the C test rebuilds it bit for bit with ldexp and Mathematica takes
   the same value as an exact rational. Cases:
     - the Kettner et al. grid: a = (1/2 + i u, 1/2 + j u), u = 2^-53,
       b = (12, 12), c = (24, 24), i, j in 0..31 (f64 orientation fails here)
     - points rounded onto random lines (near-collinear), plus exact zeros
     - near-coplanar 3D quadruples (a point of a plane rounded to doubles)
     - nearly equal ratios a/b vs c/d
   Run: wolframscript -file 64_exact_predicates.wls > 64_exact_predicates.h *)
SeedRandom[6464];
me[x_] := Module[{r = SetPrecision[x, Infinity], k},
	If[r == 0, {0, 0}, k = If[IntegerQ[r], 0, Log2[Denominator[r]]]; {r 2^k, -k}]];
dbl[x_] := N[x];            (* exact rational -> nearest machine double *)
ex[x_] := SetPrecision[x, Infinity];
o2[a_, b_, c_] := Sign[(ex[a[[1]]] - ex[c[[1]]]) (ex[b[[2]]] - ex[c[[2]]]) - (ex[a[[2]]] - ex[c[[2]]]) (ex[b[[1]]] - ex[c[[1]]])];
o3[a_, b_, c_, d_] := Sign[Det[{ex /@ (a - d), ex /@ (b - d), ex /@ (c - d)}]];
(* exact differences: Det of exact rationals, a - d taken exactly *)
o3x[a_, b_, c_, d_] := Sign[Det[{ex /@ a - ex /@ d, ex /@ b - ex /@ d, ex /@ c - ex /@ d}]];
u = 2^-53;
grid = Flatten[Table[{{1/2 + i u, 1/2 + j u}, {12, 12}, {24, 24}}, {i, 0, 31}, {j, 0, 31}], 1];
grid = Map[dbl, grid, {3}];
randline = Table[
	Module[{p = RandomReal[{-100, 100}, 2], q = RandomReal[{-100, 100}, 2], t = RandomReal[{-2, 3}]},
		{p, q, dbl /@ (SetPrecision[p, Infinity] + SetPrecision[t, Infinity] (SetPrecision[q, Infinity] - SetPrecision[p, Infinity]))}],
	{400}];
zeros = Table[Module[{k = RandomInteger[{-20, 20}], s = RandomInteger[{1, 1000}]}, N /@ {{k, 2 k}, {k + s, 2 (k + s)}, {k - 3 s, 2 (k - 3 s)}}], {20}];
o2cases = Join[grid, randline, zeros];
o3cases = Table[
	Module[{a = RandomReal[{-10, 10}, 3], b = RandomReal[{-10, 10}, 3], c = RandomReal[{-10, 10}, 3], s = RandomReal[{-2, 2}],
			t = RandomReal[{-2, 2}]},
		{a, b, c, dbl /@ (ex /@ a + ex[s] (ex /@ b - ex /@ a) + ex[t] (ex /@ c - ex /@ a))}],
	{300}];
ratios = Table[
	Module[{b = RandomReal[{-50, 50}], d = RandomReal[{-50, 50}], q = RandomReal[{-10, 10}]},
		{dbl[ex[q] ex[b]], b, dbl[ex[q] ex[d]], d}],
	{300}];
pair[x_] := Module[{v = me[x]}, "{" <> ToString[v[[1]]] <> ", " <> ToString[v[[2]]] <> "}"];
Print["/* Generated by 64_exact_predicates.wls; do not edit. */"];
Print["typedef struct ref_me { long long m; int e; } ref_me;"];
Print["typedef struct ref_o2 { ref_me p[6]; int sign; } ref_o2;"];
Print["typedef struct ref_o3 { ref_me p[12]; int sign; } ref_o3;"];
Print["typedef struct ref_ratio { ref_me p[4]; int sign; } ref_ratio;"];
Print["static ref_o2 const g_ref_o2[] = {"];
Do[Print["\t{ { ", StringRiffle[pair /@ Flatten[cs], ", "], " }, ", o2[cs[[1]], cs[[2]], cs[[3]]], " },"], {cs, o2cases}];
Print["};"];
Print["static ref_o3 const g_ref_o3[] = {"];
Do[Print["\t{ { ", StringRiffle[pair /@ Flatten[cs], ", "], " }, ", o3x[cs[[1]], cs[[2]], cs[[3]], cs[[4]]], " },"], {cs, o3cases}];
Print["};"];
Print["static ref_ratio const g_ref_ratio[] = {"];
Do[Print["\t{ { ", StringRiffle[pair /@ cs, ", "], " }, ", Sign[ex[cs[[1]]]/ex[cs[[2]]] - ex[cs[[3]]]/ex[cs[[4]]]], " },"], {cs, ratios}];
Print["};"];
