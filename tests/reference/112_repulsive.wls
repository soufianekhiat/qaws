#!/usr/bin/env wolframscript
(* Test 112's ground truth: the discrete tangent-point energies of
   docs/repulsive_plan.md, their gradients, first and second directional
   derivatives and Hessian-vector products, symbolic, evaluated at 30
   digits.
   Curves (Repulsive Curves, Eq. 17): ordered pairs of edges with no common
   vertex, l_I l_J / 4 sum over the endpoints of
   |T_I x (x_i - x_j)|^alpha / |x_i - x_j|^beta.
   Meshes (Repulsive Surfaces, Eq. 10): ordered pairs of distinct faces,
   a_S a_T |N_S . (X_S - X_T)|^p / |X_S - X_T|^(2p), X the barycenter.
   Writes 112_repulsive.h. *)

cross2[e_, d_] := If[Length[e] == 3, With[{c = Cross[e, d]}, c.c], (e[[1]] d[[2]] - e[[2]] d[[1]])^2];

curveE[X_, edges_, al_, be_] := Module[{s = 0},
  Do[
   If[Intersection[edges[[i]], edges[[j]]] === {},
    Module[{a = X[[edges[[i, 1]]]], b = X[[edges[[i, 2]]]], e, lI2, lJ2},
     e = b - a; lI2 = e.e;
     lJ2 = (X[[edges[[j, 2]]]] - X[[edges[[j, 1]]]]).(X[[edges[[j, 2]]]] - X[[edges[[j, 1]]]]);
     s += Sqrt[lI2] Sqrt[lJ2]/4 Sum[
        With[{d = X[[p]] - X[[q]]}, cross2[e, d]^(al/2)/lI2^(al/2)/(d.d)^(be/2)],
        {p, edges[[i]]}, {q, edges[[j]]}]]],
   {i, Length[edges]}, {j, Length[edges]}];
  s];

meshE[X_, tris_, p_] := Module[{s = 0},
  Do[
   If[i != j,
    Module[{m = Cross[X[[tris[[i, 2]]]] - X[[tris[[i, 1]]]], X[[tris[[i, 3]]]] - X[[tris[[i, 1]]]]],
      mT = Cross[X[[tris[[j, 2]]]] - X[[tris[[j, 1]]]], X[[tris[[j, 3]]]] - X[[tris[[j, 1]]]]], d},
     d = Total[X[[tris[[i]]]]]/3 - Total[X[[tris[[j]]]]]/3;
     s += Sqrt[m.m]/2 Sqrt[mT.mT]/2 ((m.d)^2/(m.m))^(p/2)/(d.d)^p]],
   {i, Length[tris]}, {j, Length[tris]}];
  s];

(* the derivatives of energy f (a function of the vertex list) at X0 along V *)
truth[f_, X0_, V_] := Module[{n = Length[X0], dim = Length[First[X0]], x, vars, sym, g, s, val, gr, t, t2, hv},
  vars = Flatten[Table[x[i, c], {i, n}, {c, dim}]];
  sym = f[Table[x[i, c], {i, n}, {c, dim}]];
  g = D[sym, #] & /@ vars;
  With[{rule = Thread[vars -> Flatten[X0 + s V]], rule0 = Thread[vars -> Flatten[X0]]},
   val = sym /. rule0;
   gr = g /. rule0;
   t = D[sym /. rule, s] /. s -> 0;
   t2 = D[sym /. rule, {s, 2}] /. s -> 0;
   hv = D[g /. rule, s] /. s -> 0];
  N[{val, gr, t, t2, hv}, 30]];

cs[v_] := ToString[CForm[N[v, 20]]];
arr[name_, type_, l_] := name <> "[" <> ToString[Length[l]] <> "] = { " <> StringRiffle[cs /@ l, ", "] <> " };\n";
iarr[name_, l_] := "static unsigned int const " <> name <> "[" <> ToString[Length[l]] <> "] = { " <> StringRiffle[ToString /@ l, ", "] <> " };\n";

emit[tag_, X0_, V_, idx_, params_, res_] := StringJoin[
  "/* " <> tag <> " */\n",
  "static double const " <> arr["g112_" <> tag <> "_x", "", Flatten[X0]],
  "static double const " <> arr["g112_" <> tag <> "_dir", "", Flatten[V]],
  iarr["g112_" <> tag <> "_idx", Flatten[idx - 1]],
  "static double const " <> arr["g112_" <> tag <> "_param", "", params],
  "static double const " <> arr["g112_" <> tag <> "_value", "", {res[[1]], res[[3]], res[[4]]}],
  "static double const " <> arr["g112_" <> tag <> "_grad", "", res[[2]]],
  "static double const " <> arr["g112_" <> tag <> "_hv", "", res[[5]]], "\n"];

(* curves *)
c1x = Table[{Cos[2 Pi k/7] + 1/10 Sin[3 k], Sin[2 Pi k/7] + 1/13 Cos[2 k], 3/10 Sin[4 Pi k/7]}, {k, 0, 6}] // Rationalize[N[#, 20], 0] &;
c1e = Table[{k, Mod[k, 7] + 1}, {k, 7}];
c1v = Table[{Sin[k + 1], Cos[3 k], Sin[2 k + 1]/2}, {k, 0, 6}] // Rationalize[N[#, 20], 0] &;

c2x = {{0, 0}, {1/3, 1/10}, {2/3, 3/10}, {9/10, 7/10}, {7/10, 11/10}, {3/10, 6/5}};
c2e = Table[{k, k + 1}, {k, 5}];
c2v = {{1/7, -2/9}, {3/11, 1/5}, {-1/4, 2/7}, {1/3, -1/8}, {-2/5, 1/6}, {1/9, 3/10}};

c3x = {{0, 0, 0}, {1, 1/10, 0}, {-1/2, 4/5, 1/10}, {-2/5, -3/4, -1/5},
   {2, 2, 1/2}, {3, 21/10, 0}, {5/2, 3, 1/5},
   {-2, 1, 1}, {-21/10, 2, 6/5}, {-17/10, 3, 3/2}};
c3e = {{1, 2}, {1, 3}, {1, 4}, {5, 6}, {6, 7}, {7, 5}, {8, 9}, {9, 10}};
c3v = Table[{Cos[k], Sin[2 k], Cos[3 k + 1]}, {k, 0, 9}] // Rationalize[N[#, 20], 0] &;

(* meshes *)
s1x = {{1, 0, 0}, {-1, 1/10, 0}, {0, 1, 1/20}, {1/10, -1, 0}, {0, 0, 1}, {-1/20, 1/10, -1}};
s1f = {{1, 3, 5}, {3, 2, 5}, {2, 4, 5}, {4, 1, 5}, {3, 1, 6}, {2, 3, 6}, {4, 2, 6}, {1, 4, 6}};
s1v = Table[{Sin[k], Cos[2 k], Sin[3 k + 1]}, {k, 0, 5}] // Rationalize[N[#, 20], 0] &;

s2x = {{0, 0, 0}, {1, 0, 0}, {0, 1, 0}, {0, 0, 1}, {1, 0, 1}, {0, 1, 6/5},
   {2, 0, 0}, {3, 0, 1/10}, {3, 1, 0}, {2, 1, 1/5}};
s2f = {{1, 2, 3}, {4, 5, 6}, {7, 8, 9}, {7, 9, 10}};
s2v = Table[{Cos[2 k], Sin[k + 2], Cos[k]}, {k, 0, 9}] // Rationalize[N[#, 20], 0] &;

out = StringJoin[
  "/* generated by 112_repulsive.wls: discrete tangent-point energies and their exact derivatives (30 digits)\n",
  "   value[3] = { E, dE[dir], d2E[dir, dir] }; grad = dE/dx; hv = H dir */\n\n",
  emit["c1", c1x, c1v, c1e, {3, 6}, truth[curveE[#, c1e, 3, 6] &, c1x, c1v]],
  emit["c2", c2x, c2v, c2e, {2, 9/2}, truth[curveE[#, c2e, 2, 9/2] &, c2x, c2v]],
  emit["c3", c3x, c3v, c3e, {3, 6}, truth[curveE[#, c3e, 3, 6] &, c3x, c3v]],
  emit["s1", s1x, s1v, s1f, {6}, truth[meshE[#, s1f, 6] &, s1x, s1v]],
  emit["s2", s2x, s2v, s2f, {11/2}, truth[meshE[#, s2f, 11/2] &, s2x, s2v]]];
Export[FileNameJoin[{DirectoryName[$InputFileName], "112_repulsive.h"}], out, "Text"];
Print["done"];
