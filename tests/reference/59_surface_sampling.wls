(* Ground truth for tests/59_diff_surface_sampling.c: inverse-CDF warping of
   the unit square onto a bicubic Bezier patch for the measures
   w = |Su x Sv| (area) and w = rho(S) |Su x Sv| (density), and the first
   and second derivatives of the samples with respect to the control points.

   With M(u) = int_0^1 w(u, s) ds, A(u) = int_0^u M, T = A(1) and
   B(v; u) = int_0^v w(u, s) ds, a point xi maps to (u, v) solving
     F1(u) = A(u) - xi_u T = 0,   F2(v, u) = B(v; u) - xi_v B(1; u) = 0.
   Along directions a, b of the control points the implicit function
   theorem gives
     u_a  = -F1_a / F1_u
     u_ab = -(F1_ab + F1_ua u_b + F1_ub u_a + F1_uu u_a u_b) / F1_u
     v_a  = -(F2_u u_a + F2_a) / F2_v
     v_ab = -(F2_u u_ab + F2_vv v_a v_b + F2_uu u_a u_b + F2_uv (u_a v_b + u_b v_a)
              + F2_va v_b + F2_vb v_a + F2_ua u_b + F2_ub u_a + F2_ab) / F2_v
   and the positions follow by the chain rule (S is linear in the points).
   The partial derivatives of w are symbolic in the jet y = (S, Su, Sv)
   (gradient g and Hessian H); the jet is linear in the control points, so
   w_a = g . y[a], w_ab = y[a] . H . y[b], w_u = g . y_u,
   w_uu = y_u . H . y_u + g . y_uu, w_ua = y_u . H . y[a] + g . y_u[a].
   The b directions are the 48 unit vectors and V: entry 49 gives the
   tangent and the second tangent along V, entries 1..48 the gradient and
   the Hessian-vector product of <ybar, sample>. The integrals use product
   Gauss-Legendre rules at 40 digits on [0, u] x [0, 1], [0, 1]^2 and the
   lines u = const; the rule is run at two orders and the largest relative
   difference is printed as a comment.
   Exact rationals: V[k] = (((7 k + 3) mod 11) - 5) / 10,
   ybar[k] = (((5 k + 2) mod 9) - 4) / 10 over (u, v, x, y, z) per sample.
   Run: wolframscript -file 59_surface_sampling.wls > 59_surface_sampling.h *)
fmt[v_] := Module[{m, x}, {m, x} = MantissaExponent[N[v, 20]]; If[v == 0, "0.0", ToString[NumberForm[N[m, 18], 17]] <> "e" <> ToString[x]]];
row[name_, l_] := Print["static double const " <> name <> "[] = { " <> StringRiffle[fmt /@ N[Flatten[{l}], 30], ", "] <> " };"];
Print["/* Generated by tests/reference/59_surface_sampling.wls (Mathematica, 30 digits). */"];

P0 = Flatten[Table[{j, i, (Mod[i + 2 j, 4] - 3/2)/5}, {i, 0, 3}, {j, 0, 3}], 1];
V = Partition[Table[(Mod[7 k + 3, 11] - 5)/10, {k, 0, 47}], 3];
xis = {{3/10, 3/5}, {3/4, 1/5}, {1/2, 9/10}};
ybar = Partition[Table[(Mod[5 k + 2, 9] - 4)/10, {k, 0, 14}], 5];
bern = Table[Binomial[3, i] x^i (1 - x)^(3 - i), {i, 0, 3}];
dbern = Table[D[bern, {x, o}], {o, 0, 3}];
bd[a_, b_, u_, v_] := Flatten[Outer[Times, dbern[[a + 1]] /. x -> u, dbern[[b + 1]] /. x -> v]];
ys = Table[Symbol["ys" <> ToString[k]], {k, 9}];
(* direction set: 48 unit vectors, then V *)
dirs = Join[Table[Partition[UnitVector[48, k], 3], {k, 48}], {V}];

run[tag_, rho_] := Module[{wsym, wF, gF, hF, rule, node, integ, conv = 0, res},
  wsym = rho[ys[[1 ;; 3]]] Norm[Cross[ys[[4 ;; 6]], ys[[7 ;; 9]]]] /. Abs[z_]^2 :> z^2;
  wF = Function[Evaluate[ys], Evaluate[wsym]];
  gF = Function[Evaluate[ys], Evaluate[D[wsym, {ys}]]];
  hF = Function[Evaluate[ys], Evaluate[D[wsym, {ys, 2}]]];
  (* jets at (u, v): slots (S, Su, Sv) and their u, v, uu derivatives *)
  slots[ord_, P_, u_, v_] := Flatten[Table[bd[o[[1]], o[[2]], u, v] . P, {o, ord}]];
  (* everything one node needs *)
  node[u_, v_] := Module[{B, sl, y, yu, yv, yuu, g, h, yD, yDu, hyu, hyV},
    B[a_, b_] := B[a, b] = bd[a, b, u, v];
    sl[ord_, P_] := Flatten[Table[(B @@ o) . P, {o, ord}]];
    y = sl[{{0, 0}, {1, 0}, {0, 1}}, P0];
    yu = sl[{{1, 0}, {2, 0}, {1, 1}}, P0];
    yv = sl[{{0, 1}, {1, 1}, {0, 2}}, P0];
    yuu = sl[{{2, 0}, {3, 0}, {2, 1}}, P0];
    g = gF @@ y; h = hF @@ y;
    yD = Table[sl[{{0, 0}, {1, 0}, {0, 1}}, d], {d, dirs}];
    yDu = Table[sl[{{1, 0}, {2, 0}, {1, 1}}, d], {d, dirs}];
    hyu = h . yu; hyV = h . yD[[49]];
    <|"w" -> wF @@ y, "wu" -> g . yu, "wv" -> g . yv, "wuu" -> yu . hyu + g . yuu,
      "wD" -> yD . g, "wDu" -> yD . hyu + yDu . g, "wVD" -> yD . hyV|>];
  integ[n_] := Module[{gx, gw, gerr, line, area, Mf, Af, us, vs, L1, LT, D1, DT, pt,
      F1u, F1uu, F1D, F1uD, F1VD, uD, uVD, F2v, F2vv, F2u, F2uu, F2uv, F2D, F2vD, F2uD, F2VD, vD, vVD,
      Su, Sv, Suu, Suv, Svv, SD, SuD, SvD, pD, pVD, uV, vV, out = {}},
    {gx, gw, gerr} = NIntegrate`GaussRuleData[n, 40];
    (* sums of node data over a line u = u0, v in [0, v1], and over [0, u1] x [0, 1] *)
    line[u0_, v1_, keys_] := Total[Table[v1 gw[[b]] Lookup[node[u0, v1 gx[[b]]], keys], {b, n}]];
    area[u1_, keys_] := Total[Flatten[Table[u1 gw[[a]] gw[[b]] Lookup[node[u1 gx[[a]], gx[[b]]], keys], {a, n}, {b, n}], 1]];
    Mf[u_?NumericQ] := Total[Table[gw[[b]] (wF @@ slots[{{0, 0}, {1, 0}, {0, 1}}, P0, u, gx[[b]]]), {b, n}]];
    Af[u_?NumericQ] := Total[Table[u gw[[a]] Mf[u gx[[a]]], {a, n}]];
    DT = area[1, {"wD", "wVD"}];
    Do[Module[{xu = xis[[s, 1]], xv = xis[[s, 2]], T = Af[1], Bf, u0, v0},
        u0 = us /. FindRoot[Af[us] == xu T, {us, xu}, WorkingPrecision -> 32, AccuracyGoal -> 30, PrecisionGoal -> 30];
        u0 = SetPrecision[u0, 40];   (* solved to 30 digits; keeps the v solve at its working precision *)
        Bf[v_?NumericQ] := Total[Table[v gw[[b]] (wF @@ slots[{{0, 0}, {1, 0}, {0, 1}}, P0, u0, v gx[[b]]]), {b, n}]];
        v0 = vs /. FindRoot[Bf[vs] == xv Bf[1], {vs, xv}, WorkingPrecision -> 32, AccuracyGoal -> 30, PrecisionGoal -> 30];
        D1 = area[u0, {"wD", "wVD"}];
        LT = line[u0, 1, {"w", "wu", "wuu", "wD", "wDu", "wVD"}];
        L1 = line[u0, v0, {"wu", "wuu", "wD", "wDu", "wVD"}];
        pt = node[u0, v0];
        (* marginal equation *)
        F1u = LT[[1]]; F1uu = LT[[2]];
        F1D = D1[[1]] - xu DT[[1]];
        F1VD = D1[[2]] - xu DT[[2]];
        F1uD = LT[[4]];
        uD = -F1D / F1u; uV = uD[[49]];
        uVD = -(F1VD + F1uD[[49]] uD + F1uD uV + F1uu uV uD) / F1u;
        (* conditional equation *)
        F2v = pt["w"]; F2vv = pt["wv"]; F2uv = pt["wu"];
        F2u = L1[[1]] - xv LT[[2]];
        F2uu = L1[[2]] - xv LT[[3]];
        F2D = L1[[3]] - xv LT[[4]];
        F2uD = L1[[4]] - xv LT[[5]];
        F2VD = L1[[5]] - xv LT[[6]];
        F2vD = pt["wD"];
        vD = -(F2u uD + F2D) / F2v; vV = vD[[49]];
        vVD = -(F2u uVD + F2vv vV vD + F2uu uV uD + F2uv (uV vD + uD vV) + F2vD[[49]] vD + F2vD vV +
          F2uD[[49]] uD + F2uD uV + F2VD) / F2v;
        (* positions *)
        Su = bd[1, 0, u0, v0] . P0; Sv = bd[0, 1, u0, v0] . P0;
        Suu = bd[2, 0, u0, v0] . P0; Suv = bd[1, 1, u0, v0] . P0; Svv = bd[0, 2, u0, v0] . P0;
        SD = Table[bd[0, 0, u0, v0] . d, {d, dirs}];
        SuD = Table[bd[1, 0, u0, v0] . d, {d, dirs}];
        SvD = Table[bd[0, 1, u0, v0] . d, {d, dirs}];
        pD = Table[Su uD[[k]] + Sv vD[[k]] + SD[[k]], {k, 49}];
        pVD = Table[Suu uV uD[[k]] + Suv (uV vD[[k]] + uD[[k]] vV) + Svv vV vD[[k]] + Su uVD[[k]] + Sv vVD[[k]] +
          SuD[[49]] uD[[k]] + SvD[[49]] vD[[k]] + SuD[[k]] uV + SvD[[k]] vV, {k, 49}];
        AppendTo[out, {
          Join[{u0, v0}, bd[0, 0, u0, v0] . P0],
          Join[{uD[[49]], vD[[49]]}, pD[[49]]],
          Join[{uVD[[49]], vVD[[49]]}, pVD[[49]]],
          Table[ybar[[s]] . Join[{uD[[k]], vD[[k]]}, pD[[k]]], {k, 48}],
          Table[ybar[[s]] . Join[{uVD[[k]], vVD[[k]]}, pVD[[k]]], {k, 48}]}]],
      {s, 3}];
    Append[out, Af[1]]];
  Module[{lo = integ[24], hi = integ[32]},
    conv = Max[Abs[Flatten[hi] - Flatten[lo]] / Map[Max[1, Abs[#]] &, Flatten[hi]]];
    row["ref_" <> tag <> "_total", hi[[4]]];
    Do[
      row["ref_" <> tag <> "_value" <> ToString[s - 1], hi[[s, 1]]];
      row["ref_" <> tag <> "_tangent" <> ToString[s - 1], hi[[s, 2]]];
      row["ref_" <> tag <> "_tangent2_" <> ToString[s - 1], hi[[s, 3]]];
      row["ref_" <> tag <> "_grad" <> ToString[s - 1], hi[[s, 4]]];
      row["ref_" <> tag <> "_hvp" <> ToString[s - 1], hi[[s, 5]]],
      {s, 3}];
    Print["/* " <> tag <> ": Gauss rule, 24 vs 32 points per direction: max relative difference " <> fmt[conv + 10^-40] <> " */"]]];
run["area", 1 &];
run["dens", (1 + (#[[1]]^2 + #[[2]]^2)/4 + #[[3]]/3) &];
