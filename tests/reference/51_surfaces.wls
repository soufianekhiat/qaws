(* Ground truth for tests/51_diff_surfaces.c: third order jets of a bicubic
   B-spline and of a bicubic NURBS surface with control points, weights,
   u knots and v knots as parameters, at 30 digits.

   The bases come from the Cox-de Boor recursion on symbolic knots (the
   span holding (u, v) at e = 0 is fixed, the knots are unclamped and
   distinct). Along a direction every parameter moves as x0 + e xdot and
   (u, v) as (u0, v0) + e (udot, vdot); the jet
     S = sum w_ij N_i(u) M_j(v) P_ij / sum w_ij N_i(u) M_j(v)
   and its partial derivatives (P, U, V, UU, UV, VV, UUU, UUV, UVV, VVV) are
   expanded in e exactly (Series): tangent = d/de, tangent2 = d2/de2.
   The adjoint of a jet weight ybar is the gradient of <ybar, jet> with
   respect to every control point, weight, knot, u and v.
   Exact rationals: theta_dot[k] = (((7 k + 3) mod 11) - 5) / 10 over
   (points, weights, u knots, v knots), ybar[k] = (((5 k + 2 + i) mod 9) - 4) / 10
   for sample i.
   Run: wolframscript -file 51_surfaces.wls > 51_surfaces.h *)
fmt[v_] := Module[{m, x}, {m, x} = MantissaExponent[N[v, 20]]; If[v == 0, "0.0", ToString[NumberForm[N[m, 18], 17]] <> "e" <> ToString[x]]];
row[name_, l_] := Print["static double const " <> name <> "[] = { " <> StringRiffle[fmt /@ N[Flatten[{l}], 30], ", "] <> " };"];
Print["/* Generated by tests/reference/51_surfaces.wls (Mathematica, 30 digits). */"];
d12[expr_] := Module[{s = Normal[Series[expr, {e, 0, 2}]]}, {Coefficient[s, e, 1], 2 Coefficient[s, e, 2]}];
d1[expr_] := Coefficient[Normal[Series[expr, {e, 0, 1}]], e, 1];
coxDeBoor[kn_, s_, p_, t_] := Module[{b = Table[If[i == s, 1, 0], {i, Length[kn] - 1}]},
  Do[b = Table[
      If[b[[i]] === 0, 0, (t - kn[[i]]) / (kn[[i + d]] - kn[[i]]) b[[i]]] +
      If[b[[i + 1]] === 0, 0, (kn[[i + d + 1]] - t) / (kn[[i + d + 1]] - kn[[i + 1]]) b[[i + 1]]],
      {i, Length[b] - 1}],
    {d, 1, p}];
  b];
spanOf[kn_, t_] := Last[Flatten[Position[kn, k_ /; k <= t]]];

NU = 5; NV = 4;
UK = {0, 7/20, 4/5, 6/5, 7/4, 23/10, 27/10, 31/10, 18/5};
VK = {0, 2/5, 9/10, 13/10, 19/10, 12/5, 14/5, 33/10};
P0 = Flatten[Table[{a, b, (Mod[2 a + 3 b, 5] - 2)/5}, {a, 0, NU - 1}, {b, 0, NV - 1}], 1];
W0 = Flatten[Table[1 + (2 Mod[a + 2 b, 4] - 3)/10, {a, 0, NU - 1}, {b, 0, NV - 1}]];
uvs = {{13/10, 7/5}, {8/5, 3/2}, {21/10, 9/5}};
uvdot = {{1/5, -3/10}, {-1/10, 1/5}, {3/10, 1/10}};
orders = {{0, 0}, {1, 0}, {0, 1}, {2, 0}, {1, 1}, {0, 2}, {3, 0}, {2, 1}, {1, 2}, {0, 3}};
(* jet for parameters at (uu, vv), spans (su, sv) fixed *)
(* S = A / W with A = sum w N M P, W = sum w N M; S_ab from the Leibniz
   rule of A = S W: S_ab = (A_ab - sum_{(i,j) != (0,0)} C(a,i) C(b,j) W_ij S_(a-i)(b-j)) / W *)
jet[P_, w_, uk_, vk_, su_, sv_, uu_, vv_] := Module[{bu = coxDeBoor[uk, su, 3, x], bv = coxDeBoor[vk, sv, 3, x], nu, nv, bd, A, W, S},
  nu = Table[D[bu, {x, a}] /. x -> uu, {a, 0, 3}];
  nv = Table[D[bv, {x, a}] /. x -> vv, {a, 0, 3}];
  bd[a_, b_] := Flatten[Outer[Times, nu[[a + 1]], nv[[b + 1]]]];
  A[a_, b_] := A[a, b] = (bd[a, b] w) . P;
  W[a_, b_] := W[a, b] = bd[a, b] . w;
  S[a_, b_] := S[a, b] = (A[a, b] - Sum[If[i == 0 && j == 0, 0, Binomial[a, i] Binomial[b, j] W[i, j] S[a - i, b - j]],
    {i, 0, a}, {j, 0, b}]) / W[0, 0];
  Table[S @@ o, {o, orders}]];

run[tag_, rational_] := Module[{nP = 3 NU NV, nW = If[rational, NU NV, 0], nt, dir, dP, dW, dU, dV},
  nt = nP + nW + Length[UK] + Length[VK];
  dir = Table[(Mod[7 k + 3, 11] - 5)/10, {k, 0, nt - 1}];
  dP = Partition[dir[[1 ;; nP]], 3];
  dW = If[rational, dir[[nP + 1 ;; nP + nW]], 0];
  dU = dir[[nP + nW + 1 ;; nP + nW + Length[UK]]];
  dV = dir[[nP + nW + Length[UK] + 1 ;; nt]];
  Do[Module[{u0 = uvs[[i, 1]], v0 = uvs[[i, 2]], su, sv, W = If[rational, W0, ConstantArray[1, NU NV]], tg, ybar, f, adj},
      su = spanOf[UK, u0]; sv = spanOf[VK, v0];
      tg = Identity[d12[Flatten[jet[P0 + e dP, W + e dW, UK + e dU, VK + e dV, su, sv,
        u0 + e uvdot[[i, 1]], v0 + e uvdot[[i, 2]]]]]];
      ybar = Table[(Mod[5 k + 2 + i - 1, 9] - 4)/10, {k, 0, 29}];
      f[P_, w_, uk_, vk_, uu_, vv_] := ybar . Flatten[jet[P, w, uk, vk, su, sv, uu, vv]];
      adj = Join[
        Table[d1[f[P0 + e Partition[UnitVector[nP, j], 3], W, UK, VK, u0, v0]], {j, nP}],
        If[rational, Table[d1[f[P0, W + e UnitVector[nW, j], UK, VK, u0, v0]], {j, nW}], {}],
        Table[d1[f[P0, W, UK + e UnitVector[Length[UK], j], VK, u0, v0]], {j, Length[UK]}],
        Table[d1[f[P0, W, UK, VK + e UnitVector[Length[VK], j], u0, v0]], {j, Length[VK]}],
        {d1[f[P0, W, UK, VK, u0 + e, v0]], d1[f[P0, W, UK, VK, u0, v0 + e]]}];
      row["ref_" <> tag <> "_value" <> ToString[i - 1], jet[P0, W, UK, VK, su, sv, u0, v0]];
      row["ref_" <> tag <> "_tangent" <> ToString[i - 1], tg[[1]]];
      row["ref_" <> tag <> "_tangent2_" <> ToString[i - 1], tg[[2]][[1 ;; 18]]];
      row["ref_" <> tag <> "_adjoint" <> ToString[i - 1], adj]],
    {i, 3}]];
run["bs", False];
run["nr", True];
