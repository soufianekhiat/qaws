#!/usr/bin/env wolframscript
(* Test 117's ground truth: the curves' tangent-point energy (Repulsive
   Curves, Eq. 17; as in 112_repulsive.wls) of polygons whose vertices lie
   on a bicubic Bezier patch S(u, v), as a function of the vertices'
   parameters (u_i, v_i): E(S(q)). Its gradient in q, first and second
   directional derivatives and Hessian-vector product, symbolic, at 30
   digits. Writes 117_repulsive_surface.h. *)

cross2[e_, d_] := With[{c = Cross[e, d]}, c.c];

curveE[X_, edges_, al_, be_] := Module[{s = 0},
  Do[
   If[Intersection[edges[[i]], edges[[j]]] === {},
    Module[{a = X[[edges[[i, 1]]]], b = X[[edges[[i, 2]]]], e, lI2, lJ2},
     e = b - a; lI2 = e.e;
     lJ2 = (X[[edges[[j, 2]]]] - X[[edges[[j, 1]]]]).(X[[edges[[j, 2]]]] - X[[edges[[j, 1]]]]);
     s += Sqrt[lI2] Sqrt[lJ2]/4 Sum[
        With[{d = X[[p]] - X[[q]]}, cross2[e, d]^(al/2)/lI2^(al/2)/(d.d)^(be/2)],
        {p, edges[[i]]}, {q, edges[[j]]}]]],
   {i, Length[edges]}, {j, Length[edges]}];
  s];

(* the patch: P[[i + 1, j + 1]], i along u *)
P = Table[{i/3 + Sin[3 i + j]/10, j/3 + Cos[2 i - j]/12, Sin[i + 2 j]/4 + (i - 3/2) (j - 3/2)/9}, {i, 0, 3}, {j, 0, 3}] // Rationalize[N[#, 20], 0] &;
bern[k_, t_] := Binomial[3, k] t^k (1 - t)^(3 - k);
S[{u_, v_}] := Sum[bern[i, u] bern[j, v] P[[i + 1, j + 1]], {i, 0, 3}, {j, 0, 3}];

(* value, t and t2 by composition along the line Q0 + s V (one variable);
   the gradient and Hv by the chain rule from the symbolic x-space
   derivatives and S's exact derivatives (the composed expression in all
   parameters is too large to differentiate whole) *)
Su[{u_, v_}] := Evaluate[D[S[{uu, vv}], uu] /. {uu -> u, vv -> v}];
Sv[{u_, v_}] := Evaluate[D[S[{uu, vv}], vv] /. {uu -> u, vv -> v}];
Suu[{u_, v_}] := Evaluate[D[S[{uu, vv}], {uu, 2}] /. {uu -> u, vv -> v}];
Suv[{u_, v_}] := Evaluate[D[S[{uu, vv}], uu, vv] /. {uu -> u, vv -> v}];
Svv[{u_, v_}] := Evaluate[D[S[{uu, vv}], {vv, 2}] /. {uu -> u, vv -> v}];

truth[edges_, Q0_, V_] := Module[{n = Length[Q0], x, xvars, sym, g, s, line, val, t, t2, X0, gx, Hdx, dx, gr, hv},
  line = curveE[S /@ (Q0 + s V), edges, 3, 6];
  val = line /. s -> 0;
  t = D[line, s] /. s -> 0;
  t2 = D[line, {s, 2}] /. s -> 0;
  xvars = Flatten[Table[x[i, c], {i, n}, {c, 3}]];
  sym = curveE[Table[x[i, c], {i, n}, {c, 3}], edges, 3, 6];
  g = D[sym, #] & /@ xvars;
  X0 = S /@ Q0;
  dx = Table[Su[Q0[[i]]] V[[i, 1]] + Sv[Q0[[i]]] V[[i, 2]], {i, n}];
  With[{rule = Thread[xvars -> Flatten[X0 + s dx]], rule0 = Thread[xvars -> Flatten[X0]]},
   gx = Partition[g /. rule0, 3];
   Hdx = Partition[D[g /. rule, s] /. s -> 0, 3]];
  gr = Flatten[Table[{Su[Q0[[i]]].gx[[i]], Sv[Q0[[i]]].gx[[i]]}, {i, n}]];
  hv = Flatten[Table[{
      Su[Q0[[i]]].Hdx[[i]] + gx[[i]].(Suu[Q0[[i]]] V[[i, 1]] + Suv[Q0[[i]]] V[[i, 2]]),
      Sv[Q0[[i]]].Hdx[[i]] + gx[[i]].(Suv[Q0[[i]]] V[[i, 1]] + Svv[Q0[[i]]] V[[i, 2]])}, {i, n}]];
  N[{val, gr, t, t2, hv}, 30]];

cs[v_] := ToString[CForm[N[v, 20]]];
arr[name_, l_] := "static double const " <> name <> "[" <> ToString[Length[l]] <> "] = { " <> StringRiffle[cs /@ l, ", "] <> " };\n";
iarr[name_, l_] := "static unsigned int const " <> name <> "[" <> ToString[Length[l]] <> "] = { " <> StringRiffle[ToString /@ l, ", "] <> " };\n";

emit[tag_, Q0_, V_, idx_, res_] := StringJoin[
  "/* " <> tag <> " */\n",
  arr["g117_" <> tag <> "_uv", Flatten[Q0]],
  arr["g117_" <> tag <> "_dir", Flatten[V]],
  iarr["g117_" <> tag <> "_idx", Flatten[idx - 1]],
  arr["g117_" <> tag <> "_value", {res[[1]], res[[3]], res[[4]]}],
  arr["g117_" <> tag <> "_grad", res[[2]]],
  arr["g117_" <> tag <> "_hv", res[[5]]], "\n"];

(* a closed hexagon *)
h1q = Table[{1/2 + 3/10 Cos[2 Pi k/6] + Sin[k]/40, 1/2 + 3/10 Sin[2 Pi k/6] + Cos[2 k]/50}, {k, 0, 5}] // Rationalize[N[#, 20], 0] &;
h1e = Table[{k, Mod[k, 6] + 1}, {k, 6}];
h1v = Table[{Sin[k + 1]/3, Cos[2 k]/4}, {k, 0, 5}] // Rationalize[N[#, 20], 0] &;

(* an open polyline and a separate segment *)
h2q = {{1/10, 1/5}, {3/10, 1/4}, {1/2, 1/5}, {7/10, 3/10}, {9/10, 1/4}, {1/4, 3/4}, {3/4, 7/10}};
h2e = {{1, 2}, {2, 3}, {3, 4}, {4, 5}, {6, 7}};
h2v = Table[{Cos[3 k]/5, Sin[k + 2]/6}, {k, 0, 6}] // Rationalize[N[#, 20], 0] &;

out = StringJoin[
  "/* generated by 117_repulsive_surface.wls: the curve energy (alpha, beta) = (3, 6) of polygons on a bicubic\n",
  "   Bezier patch, in the vertices' parameters, and its exact derivatives (30 digits)\n",
  "   value[3] = { E, dE[dir], d2E[dir, dir] }; grad = dE/duv; hv = H dir */\n\n",
  arr["g117_patch", Flatten[P]], "\n",
  emit["h1", h1q, h1v, h1e, truth[h1e, h1q, h1v]],
  emit["h2", h2q, h2v, h2e, truth[h2e, h2q, h2v]]];
Export[FileNameJoin[{DirectoryName[$InputFileName], "117_repulsive_surface.h"}], out, "Text"];
Print["done"];
