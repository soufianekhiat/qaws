(* Ground truth for tests/52_diff_geometry.c: local differential geometry
   through the full chain parameters -> jet -> quantity, at 30 digits.

     3D curve (cubic B-spline): T, N = B x T, B, speed, curvature, torsion
     2D curve (quartic Bezier): T, N (T rotated by +90 degrees), speed,
                                signed curvature
     surface (bicubic NURBS):   normal, E F G, L M N, Gaussian, mean,
                                kappa1, kappa2

   Along a direction the parameters move as x0 + e xdot and the evaluation
   parameter as t0 + e tdot ((u0, v0) + e (udot, vdot) on the surface). The
   jet is a rational function of e with exact rational coefficients; the
   quantity is expanded in e (Series; exactly for the curves, from 60-digit
   inputs for the surface) and
     tangent = d/de, tangent2 = d2/de2 at e = 0.
   The adjoint of a fixed quantity weight gbar is the gradient of
   <gbar, quantity> with respect to every parameter and t (u, v): one first
   order expansion along each unit direction.
   Run: wolframscript -file 52_geometry.wls > 52_geometry.h *)
fmt[v_] := Module[{m, x}, {m, x} = MantissaExponent[N[v, 20]]; If[v == 0, "0.0", ToString[NumberForm[N[m, 18], 17]] <> "e" <> ToString[x]]];
row[name_, l_] := Print["static double const " <> name <> "[] = { " <> StringRiffle[fmt /@ N[Flatten[{l}], 30], ", "] <> " };"];
Print["/* Generated by tests/reference/52_geometry.wls (Mathematica, 30 digits). */"];
(* first and second derivative in e at 0 of an expression analytic in e *)
d12[expr_] := Module[{s = Normal[Series[expr, {e, 0, 2}]]}, {Coefficient[s, e, 1], 2 Coefficient[s, e, 2]}];
d1[expr_] := Coefficient[Normal[Series[expr, {e, 0, 1}]], e, 1];
units[n_] := IdentityMatrix[n];

(* ------------------------------------------------------------- 3D curve *)
geo3[{c1_, c2_, c3_}] := Module[{s = Sqrt[c1 . c1], b = Cross[c1, c2], bl, tt, bb},
  bl = Sqrt[b . b]; tt = c1 / s; bb = b / bl;
  Join[tt, Cross[bb, tt], bb, {s, bl / s^3, b . c3 / bl^2}]];
knots = {0, 0, 0, 0, 1, 2, 3, 3, 3, 3};
P3 = {{0, 0, 0}, {1, 2, 1/2}, {5/2, 3/2, -1}, {3, -1, 1}, {9/2, 1/2, 2}, {6, 2, 0}};
V3 = Partition[{1/5, -3/10, 1/10, -1/4, 1/5, 3/10, 1/10, 1/10, -1/5, 3/10, -1/5, 1/4, -1/5, 3/10, -1/10, 1/10, -1/4, 1/5}, 3];
ts3 = {2/5, 13/10, 5/2};
tdot3 = {1/2, -3/10, 7/10};
gbar3 = {3/10, -1/5, 1/2, -2/5, 1/10, 1/4, 1/5, -3/10, 2/5, -1/2, 3/5, -1/4};
B3 = Table[Table[Simplify[PiecewiseExpand[BSplineBasis[{3, knots}, i - 1, u]], k < u < k + 1], {i, 6}], {k, 0, 2}];
jet3[P_, t_] := jet3[P, t, Min[Floor[t /. e -> 0], 2]];
jet3[P_, t_, k_] := Module[{c = B3[[k + 1]] . P},
  {D[c, u], D[c, {u, 2}], D[c, {u, 3}]} /. u -> t];
Do[Module[{t0 = ts3[[i]], tg},
    tg = Identity[d12[geo3[jet3[P3 + e V3, t0 + e tdot3[[i]]]]]];
    row["ref_c3_value" <> ToString[i - 1], geo3[jet3[P3, t0]]];
    row["ref_c3_tangent" <> ToString[i - 1], tg[[1]]];
    row["ref_c3_tangent2_" <> ToString[i - 1], tg[[2]]];
    row["ref_c3_adjoint" <> ToString[i - 1], Append[
      Table[d1[gbar3 . geo3[jet3[P3 + e Partition[units[18][[j]], 3], t0]]], {j, 18}],
      d1[gbar3 . geo3[jet3[P3, t0 + e]]]]]],
  {i, 3}];

(* ------------------------------------------------------------- 2D curve *)
geo2[{c1_, c2_}] := Module[{s = Sqrt[c1 . c1], tt},
  tt = c1 / s;
  Join[tt, {-tt[[2]], tt[[1]]}, {s, (c1[[1]] c2[[2]] - c1[[2]] c2[[1]]) / s^3}]];
P2 = {{0, 0}, {1, 2}, {5/2, -1}, {4, 3/2}, {5, 0}};
V2 = Partition[{3/10, -1/5, 1/10, 2/5, -1/4, 1/5, 1/10, -3/10, 1/5, 1/10}, 2];
ts2 = {1/5, 1/2, 4/5};
tdot2 = {-2/5, 3/10, 1/2};
gbar2 = {1/5, -3/10, 2/5, 1/10, -1/2, 3/10};
jet2[P_, t_] := Module[{c = Table[Binomial[4, i] u^i (1 - u)^(4 - i), {i, 0, 4}] . P},
  {D[c, u], D[c, {u, 2}]} /. u -> t];
Do[Module[{t0 = ts2[[i]], tg},
    tg = Identity[d12[geo2[jet2[P2 + e V2, t0 + e tdot2[[i]]]]]];
    row["ref_c2_value" <> ToString[i - 1], geo2[jet2[P2, t0]]];
    row["ref_c2_tangent" <> ToString[i - 1], tg[[1]]];
    row["ref_c2_tangent2_" <> ToString[i - 1], tg[[2]]];
    row["ref_c2_adjoint" <> ToString[i - 1], Append[
      Table[d1[gbar2 . geo2[jet2[P2 + e Partition[units[10][[j]], 2], t0]]], {j, 10}],
      d1[gbar2 . geo2[jet2[P2, t0 + e]]]]]],
  {i, 3}];

(* -------------------------------------------------------------- surface *)
geoS[{su_, sv_, suu_, suv_, svv_}] := Module[{n = Cross[su, sv], nl, nn, ee, ff, gg, l, m, nq, det, k, h, r},
  nl = Sqrt[n . n]; nn = n / nl;
  ee = su . su; ff = su . sv; gg = sv . sv;
  l = suu . nn; m = suv . nn; nq = svv . nn;
  det = ee gg - ff^2;
  k = (l nq - m^2) / det; h = (ee nq + gg l - 2 ff m) / (2 det); r = Sqrt[h^2 - k];
  Join[nn, {ee, ff, gg, l, m, nq, k, h, h + r, h - r}]];
bern = Table[Binomial[3, i] x^i (1 - x)^(3 - i), {i, 0, 3}];
SP = Flatten[Table[{i + (Mod[i + 2 j, 3] - 1)/10, j + (Mod[2 i + j, 3] - 1)/10,
  2/5 (i - 3/2)^2 - 1/4 (j - 3/2)^2 + (Mod[i + j, 3] - 1)/10}, {i, 0, 3}, {j, 0, 3}], 1];
SW = Flatten[Table[1 + (2 Mod[i + 3 j, 4] - 3)/10, {i, 0, 3}, {j, 0, 3}]];
SVP = Flatten[Table[(Mod[5 i + 3 j + 7 c, 9] - 4)/10, {i, 0, 3}, {j, 0, 3}, {c, 0, 2}], 1];
SVW = Flatten[Table[(Mod[3 i + j, 5] - 2)/20, {i, 0, 3}, {j, 0, 3}]];
uvs = {{1/5, 3/4}, {1/2, 2/5}, {4/5, 1/10}};
uvdot = {{1/2, -3/10}, {-1/5, 2/5}, {3/10, 1/10}};
gbarS = {1/5, -3/10, 1/2, 3/10, -1/5, 1/10, -2/5, 1/4, 3/10, -1/10, 1/5, 2/5, -3/10};
(* exact radicals of the principal curvatures make exact series slow: the
   rational inputs are taken to 60 digits instead *)
{SP, SW, SVP, SVW, uvs, uvdot} = N[{SP, SW, SVP, SVW, uvs, uvdot}, 60];
(* S = A / W with A = sum w B P, W = sum w B; the partials of A and W are
   linear in the parameters and S_ab follows from the Leibniz rule of
   A = S W: S_ab = (A_ab - sum_{(i,j) != (0,0)} C(a,i) C(b,j) W_ij S_(a-i)(b-j)) / W *)
bd[a_, b_, u0_, v0_] := Flatten[Outer[Times, D[bern, {x, a}] /. x -> u0, D[bern, {x, b}] /. x -> v0]];
jetS[P_, w_, u0_, v0_] := Module[{A, W, S},
  A[a_, b_] := A[a, b] = (bd[a, b, u0, v0] w) . P;
  W[a_, b_] := W[a, b] = bd[a, b, u0, v0] . w;
  S[a_, b_] := S[a, b] = (A[a, b] - Sum[If[i == 0 && j == 0, 0, Binomial[a, i] Binomial[b, j] W[i, j] S[a - i, b - j]],
    {i, 0, a}, {j, 0, b}]) / W[0, 0];
  {S[1, 0], S[0, 1], S[2, 0], S[1, 1], S[0, 2]}];
Do[Module[{u0 = uvs[[i, 1]], v0 = uvs[[i, 2]], tg, adjP, adjW},
    tg = Identity[d12[geoS[jetS[SP + e SVP, SW + e SVW, u0 + e uvdot[[i, 1]], v0 + e uvdot[[i, 2]]]]]];
    adjP = Table[d1[gbarS . geoS[jetS[SP + e Partition[units[48][[j]], 3], SW, u0, v0]]], {j, 48}];
    adjW = Table[d1[gbarS . geoS[jetS[SP, SW + e units[16][[j]], u0, v0]]], {j, 16}];
    row["ref_s_value" <> ToString[i - 1], geoS[jetS[SP, SW, u0, v0]]];
    row["ref_s_tangent" <> ToString[i - 1], tg[[1]]];
    row["ref_s_tangent2_" <> ToString[i - 1], tg[[2]]];
    row["ref_s_adjoint" <> ToString[i - 1], Join[adjP, adjW,
      {d1[gbarS . geoS[jetS[SP, SW, u0 + e, v0]]], d1[gbarS . geoS[jetS[SP, SW, u0, v0 + e]]]}]]],
  {i, 3}];
