#!/usr/bin/env wolframscript
(* Test 113's ground truth: the fractional Sobolev metric A = B + B0 of
   Repulsive Curves (Sec. 5.2), from its definition as a bilinear form
   (Eq. 21 and the low-order term), its entries as the mixed derivatives
   d^2 form / du_i dv_j; not from the increment rules. Writes
   113_repulsive_metric.h. *)

cross2[e_, d_] := If[Length[e] == 3, With[{c = Cross[e, d]}, c.c], (e[[1]] d[[2]] - e[[2]] d[[1]])^2];

metric[X_, edges_, al_, be_] := Module[{n = Length[X], sig = (be - 1)/al - 1, ex, u, v, form = 0},
  ex = 2 sig + 1;
  Do[
   If[Intersection[edges[[I]], edges[[J]]] === {},
    Module[{i1 = edges[[I, 1]], i2 = edges[[I, 2]], j1 = edges[[J, 1]], j2 = edges[[J, 2]], lI, lJ, TI, TJ, w, w0, DIu, DJu, DIv, DJv},
     lI = Sqrt[(X[[i2]] - X[[i1]]).(X[[i2]] - X[[i1]])]; lJ = Sqrt[(X[[j2]] - X[[j1]]).(X[[j2]] - X[[j1]])];
     TI = (X[[i2]] - X[[i1]])/lI; TJ = (X[[j2]] - X[[j1]])/lJ;
     w = lI lJ/4 Sum[1/((X[[p]] - X[[q]]).(X[[p]] - X[[q]]))^(ex/2), {p, {i1, i2}}, {q, {j1, j2}}];
     w0 = lI lJ/4 Sum[With[{d = X[[p]] - X[[q]]}, cross2[TI, d]/(d.d)^2/(d.d)^(ex/2)], {p, {i1, i2}}, {q, {j1, j2}}];
     DIu = (u[i2] - u[i1]) TI/lI; DJu = (u[j2] - u[j1]) TJ/lJ;
     DIv = (v[i2] - v[i1]) TI/lI; DJv = (v[j2] - v[j1]) TJ/lJ;
     form += w (DIu - DJu).(DIv - DJv) + w0 ((u[i1] + u[i2])/2 - (u[j1] + u[j2])/2) ((v[i1] + v[i2])/2 - (v[j1] + v[j2])/2)]],
   {I, Length[edges]}, {J, Length[edges]}];
  N[Table[D[form, u[i], v[j]], {i, n}, {j, n}], 30]];

cs[v_] := ToString[CForm[N[v, 20]]];
emit[tag_, X_, edges_, al_, be_] := StringJoin[
  "static double const g113_" <> tag <> "_x[" <> ToString[Length[Flatten[X]]] <> "] = { " <> StringRiffle[cs /@ Flatten[X], ", "] <> " };\n",
  "static unsigned int const g113_" <> tag <> "_idx[" <> ToString[Length[Flatten[edges]]] <> "] = { " <> StringRiffle[ToString /@ Flatten[edges - 1], ", "] <> " };\n",
  "static double const g113_" <> tag <> "_param[2] = { " <> cs[al] <> ", " <> cs[be] <> " };\n",
  With[{A = metric[X, edges, al, be]}, "static double const g113_" <> tag <> "_A[" <> ToString[Length[Flatten[A]]] <> "] = { " <> StringRiffle[cs /@ Flatten[A], ", "] <> " };\n\n"]];

c1x = Table[{Cos[2 Pi k/7] + 1/10 Sin[3 k], Sin[2 Pi k/7] + 1/13 Cos[2 k], 3/10 Sin[4 Pi k/7]}, {k, 0, 6}] // Rationalize[N[#, 20], 0] &;
c1e = Table[{k, Mod[k, 7] + 1}, {k, 7}];
c2x = {{0, 0}, {1/3, 1/10}, {2/3, 3/10}, {9/10, 7/10}, {7/10, 11/10}, {3/10, 6/5}};
c2e = Table[{k, k + 1}, {k, 5}];
Export[FileNameJoin[{DirectoryName[$InputFileName], "113_repulsive_metric.h"}],
  StringJoin["/* generated by 113_repulsive_metric.wls: the fractional Sobolev metric A = B + B0 (Repulsive Curves, Sec. 5.2) from its bilinear form */\n\n",
   emit["c1", c1x, c1e, 3, 6], emit["c2", c2x, c2e, 2, 9/2]], "Text"];
Print["done"];
