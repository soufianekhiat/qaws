(* Ground truth for tests/77_exact_curve_surface.c: intersections of 3D Bezier /
   rational Bezier curves C(t) with Bezier / NURBS surfaces S(u, v).

   Per knot rectangle, X_c(u, v) W_C(t) - C_c(t) W(u, v) = 0 (c = x, y, z)
   is solved (NSolve, 80 digits: an exact Groebner elimination, roots extracted
   numerically; s W W_C = 1 removes the points at infinity W = W_C = 0)
   with (u, v) in the rectangle and t in [0, 1]. Hits are
   deduplicated, sorted by t, listed as 25-digit decimals (t, u, v).
   Coordinates are lattice integers (2^-10 world units).
   Run: wolframscript -file 77_exact_curve_surface.wls > 77_exact_curve_surface.h *)
SeedRandom[7777];
fmt[r_] := If[r == 0, "0", Module[{m, e}, {m, e} = MantissaExponent[N[r, 40]]; ToString[Round[m 10^25]] <> "e" <> ToString[e - 25]]];
bern[n_, i_, t_] := Binomial[n, i] t^i (1 - t)^(n - i);
basisOn[knots_, p_, n_, s_, t_] := Module[{nb},
	nb[i_, 0] := If[i == s, 1, 0];
	nb[i_, k_] := nb[i, k] = Module[{a = knots[[i + k + 1]] - knots[[i + 1]], b = knots[[i + k + 2]] - knots[[i + 2]]},
		Expand[If[a == 0, 0, (t - knots[[i + 1]])/a nb[i, k - 1]] + If[b == 0, 0, (knots[[i + k + 2]] - t)/b nb[i + 1, k - 1]]]];
	Table[nb[i, p], {i, 0, n - 1}]];
clamped[p_, n_] := Join[ConstantArray[0, p + 1], Range[1, n - p - 1], ConstantArray[n - p, p + 1]];
homPatch[ku_, kv_, p_, q_, cp_, w_, su_, sv_, u_, v_] := Module[{nu = Length[cp], nv = Length[cp[[1]]], Bu, Bv},
	Bu = basisOn[ku, p, nu, su, u];
	Bv = basisOn[kv, q, nv, sv, v];
	Append[Table[Expand[Sum[Bu[[i]] Bv[[j]] w[[i, j]] cp[[i, j, c]], {i, nu}, {j, nv}]], {c, 3}], Expand[Sum[Bu[[i]] Bv[[j]] w[[i, j]], {i, nu}, {j, nv}]]]];
homCurve[cp_, w_, t_] := Module[{n = Length[cp] - 1}, Append[Table[Sum[bern[n, i, t] w[[i + 1]] cp[[i + 1, c]], {i, 0, n}], {c, 3}],
	Sum[bern[n, i, t] w[[i + 1]], {i, 0, n}]]];
hits[ku_, kv_, p_, q_, cp_, w_, ccp_, cw_] := Module[{nu = Length[cp], nv = Length[cp[[1]]], res = {}, u, v, t, sw, C},
	C = homCurve[ccp, cw, t];
	Do[
		If[ku[[su + 1]] < ku[[su + 2]] && kv[[sv + 1]] < kv[[sv + 2]],
			Module[{H = homPatch[ku, kv, p, q, cp, w, su, sv, u, v], sols},
				sols = NSolve[Append[Table[Expand[H[[c]] C[[4]] - C[[c]] H[[4]]] == 0, {c, 3}], sw H[[4]] C[[4]] == 1], {u, v, t, sw}, WorkingPrecision -> 80];
				sols = Select[{u, v, t} /. sols, (Max[Abs[Im[#]]] < 10^-50 && ku[[su + 1]] - 10^-50 <= Re[#[[1]]] <= ku[[su + 2]] + 10^-50 &&
					kv[[sv + 1]] - 10^-50 <= Re[#[[2]]] <= kv[[sv + 2]] + 10^-50 && -10^-50 <= Re[#[[3]]] <= 1 + 10^-50) &];
				If[sols =!= {}, res = Join[res, Re[{#[[3]], #[[1]], #[[2]]}] & /@ sols]]]],
		{su, p, nu - 1}, {sv, q, nv - 1}];
	SortBy[DeleteDuplicates[res, Norm[#1 - #2] < 10^-40 &], #[[1]] &]];
cases = {};
Do[
	Module[{p = pq[[1]], q = pq[[2]], cp, w, ku, kv, ccp, cw, H, P, C0, u, v, t, t0},
		cp = RandomInteger[{-2^16, 2^16}, {p + 1, q + 1, 3}];
		w = If[rat == 1, RandomInteger[{1, 12}, {p + 1, q + 1}], ConstantArray[1, {p + 1, q + 1}]];
		ku = clamped[p, p + 1];
		kv = clamped[q, q + 1];
		(* a curve through a rounded surface point at t0 *)
		H = homPatch[ku, kv, p, q, cp, w, p, q, u, v] /. {u -> RandomInteger[{15, 85}]/100, v -> RandomInteger[{15, 85}]/100};
		P = Round[Most[H]/Last[H]];
		ccp = RandomInteger[{-2^16, 2^16}, {m + 1, 3}];
		cw = If[rat == 1, RandomInteger[{1, 12}, m + 1], ConstantArray[1, m + 1]];
		t0 = RandomInteger[{20, 80}]/100;
		C0 = homCurve[ccp, cw, t] /. t -> t0;
		ccp = Round[(# + P - Most[C0]/Last[C0]) & /@ ccp];
		AppendTo[cases, {p, q, rat, cp, w, ku, kv, m, ccp, cw}];
		(* a random curve *)
		AppendTo[cases, {p, q, rat, cp, w, ku, kv, m, RandomInteger[{-2^16, 2^16}, {m + 1, 3}], cw}]],
	{pq, {{1, 1}, {2, 2}, {3, 3}}}, {m, {1, 2, 3}}, {rat, {0, 1}}];
(* a 2 x 2-patch NURBS surface *)
Do[
	Module[{cp = RandomInteger[{-2^16, 2^16}, {4, 4, 3}], w = RandomInteger[{1, 12}, {4, 4}], ku = clamped[2, 4], H, P, ccp, cw, C0, u, v, t},
		H = homPatch[ku, ku, 2, 2, cp, w, 2, 3, u, v] /. {u -> 3/10, v -> 17/10};
		P = Round[Most[H]/Last[H]];
		ccp = RandomInteger[{-2^16, 2^16}, {3, 3}];
		cw = RandomInteger[{1, 12}, 3];
		C0 = homCurve[ccp, cw, t] /. t -> 1/3;
		ccp = Round[(# + P - Most[C0]/Last[C0]) & /@ ccp];
		AppendTo[cases, {2, 2, 1, cp, w, ku, ku, 2, ccp, cw}]],
	{rep, 2}];
Print["/* Generated by 77_exact_curve_surface.wls; do not edit. */"];
Print["typedef struct ref_exact_curve_surface { int p, q, rational, nu, nv; long long cp[4 * 4 * 3]; long long w[16]; long long ku[8]; long long kv[8]; int nku, nkv; int m; long long ccp[4 * 3]; long long cw[4]; int n; char const* t[12]; char const* u[12]; char const* v[12]; } ref_exact_curve_surface;"];
Print["static ref_exact_curve_surface const g_ref_exact_curve_surface[] = {"];
Do[
	Module[{p = cs[[1]], q = cs[[2]], rat = cs[[3]], cp = cs[[4]], w = cs[[5]], ku = cs[[6]], kv = cs[[7]], m = cs[[8]], ccp = cs[[9]], cw = cs[[10]], list},
		list = hits[ku, kv, p, q, cp, w, ccp, cw];
		Print["\t{ ", p, ", ", q, ", ", rat, ", ", Length[cp], ", ", Length[cp[[1]]], ", { ", StringRiffle[ToString /@ Flatten[cp], ", "], " }, { ",
			StringRiffle[ToString /@ Flatten[w], ", "], " }, { ", StringRiffle[ToString /@ ku, ", "], " }, { ", StringRiffle[ToString /@ kv, ", "], " }, ",
			Length[ku], ", ", Length[kv], ", ", m, ", { ", StringRiffle[ToString /@ Flatten[ccp], ", "], " }, { ", StringRiffle[ToString /@ cw, ", "], " }, ",
			Length[list], ", { ",
			If[list === {}, "0", StringRiffle["\"" <> fmt[#[[1]]] <> "\"" & /@ list, ", "]], " }, { ",
			If[list === {}, "0", StringRiffle["\"" <> fmt[#[[2]]] <> "\"" & /@ list, ", "]], " }, { ",
			If[list === {}, "0", StringRiffle["\"" <> fmt[#[[3]]] <> "\"" & /@ list, ", "]], " } },"]],
	{cs, cases}];
Print["};"];
