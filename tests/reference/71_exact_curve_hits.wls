(* Ground truth for tests/71_exact_curve_hits.c: intersections of two 2D
   Bezier / rational Bezier curves, A(s) = B(r) with s, r in [0, 1].

   Solved exactly from X_A W_B - X_B W_A = 0, Y_A W_B - Y_B W_A = 0 (the
   weights are positive). Each solution is listed with both parameters
   (decimal, 25 digits) and whether each is a dyadic rational. Pairs of
   polynomial curves built to meet at A(1/2) = B(1/2) give exact points.
   Coordinates are lattice integers (2^-10 world units).
   Run: wolframscript -file 71_exact_curve_hits.wls > 71_exact_curve_hits.h *)
SeedRandom[7171];
bern[n_, i_, t_] := Binomial[n, i] t^i (1 - t)^(n - i);
hom[cp_, w_, t_] := Module[{n = Length[cp] - 1}, {Sum[bern[n, i, t] w[[i + 1]] cp[[i + 1, 1]], {i, 0, n}],
	Sum[bern[n, i, t] w[[i + 1]] cp[[i + 1, 2]], {i, 0, n}], Sum[bern[n, i, t] w[[i + 1]], {i, 0, n}]}];
dyadicQ[r0_] := Module[{r = RootReduce[r0]}, IntegerQ[r] || (Head[r] === Rational && Denominator[r] == 2^(IntegerLength[Denominator[r], 2] - 1))];
fmt[r_] := If[r == 0, "0", Module[{m, e}, {m, e} = MantissaExponent[N[r, 40]]; ToString[Round[m 10^25]] <> "e" <> ToString[e - 25]]];
mk[d_, rat_, scale_] := {scale RandomInteger[{-2^19/scale, 2^19/scale}, {d + 1, 2}], If[rat == 1, RandomInteger[{1, 40}, d + 1], ConstantArray[1, d + 1]]};
cases = {};
Do[
	Module[{a = mk[da, ra, 1], b = mk[db, rb, 1]}, AppendTo[cases, Join[{da, ra}, a, {db, rb}, b]]],
	{da, {1, 2, 3, 4}}, {db, {1, 2, 3}}, {ra, {0, 1}}, {rb, {0, 1}}];
(* polynomial pairs through one exact point at s = r = 1/2 *)
Do[
	Module[{a = mk[da, 0, 2^4], b = mk[db, 0, 2^4], pa, pb, t},
		pa = Most[hom[a[[1]], a[[2]], t] /. t -> 1/2];
		pb = Most[hom[b[[1]], b[[2]], t] /. t -> 1/2];
		b[[1]] = (# + pa - pb) & /@ b[[1]];
		AppendTo[cases, Join[{da, 0}, a, {db, 0}, b]]],
	{da, {2, 3, 4}}, {db, {1, 2, 3}}];
Print["/* Generated by 71_exact_curve_hits.wls; do not edit. */"];
Print["typedef struct ref_exact_curve_hits { int da, ra; long long acp[5 * 2]; long long aw[5]; int db, rb; long long bcp[5 * 2]; long long bw[5]; int n; char const* s[24]; char const* r[24]; int sdy[24]; int rdy[24]; } ref_exact_curve_hits;"];
Print["static ref_exact_curve_hits const g_ref_exact_curve_hits[] = {"];
Do[
	Module[{da = cs[[1]], ra = cs[[2]], acp = cs[[3]], aw = cs[[4]], db = cs[[5]], rb = cs[[6]], bcp = cs[[7]], bw = cs[[8]], s, r, A, B, sols, list},
		A = hom[acp, aw, s];
		B = hom[bcp, bw, r];
		sols = Solve[{Expand[A[[1]] B[[3]] - B[[1]] A[[3]]] == 0, Expand[A[[2]] B[[3]] - B[[2]] A[[3]]] == 0, 0 <= s <= 1, 0 <= r <= 1}, {s, r}, Reals];
		list = If[sols === {}, {}, SortBy[DeleteDuplicates[RootReduce[{s, r} /. sols]], N[#[[1]]] &]];
		Print["\t{ ", da, ", ", ra, ", { ", StringRiffle[ToString /@ Flatten[acp], ", "], " }, { ", StringRiffle[ToString /@ aw, ", "], " }, ",
			db, ", ", rb, ", { ", StringRiffle[ToString /@ Flatten[bcp], ", "], " }, { ", StringRiffle[ToString /@ bw, ", "], " }, ", Length[list], ", { ",
			If[list === {}, "0", StringRiffle["\"" <> fmt[#[[1]]] <> "\"" & /@ list, ", "]], " }, { ",
			If[list === {}, "0", StringRiffle["\"" <> fmt[#[[2]]] <> "\"" & /@ list, ", "]], " }, { ",
			If[list === {}, "0", StringRiffle[ToString[If[dyadicQ[#[[1]]], 1, 0]] & /@ list, ", "]], " }, { ",
			If[list === {}, "0", StringRiffle[ToString[If[dyadicQ[#[[2]]], 1, 0]] & /@ list, ", "]], " } },"]],
	{cs, cases}];
Print["};"];
